{
  "blocks": [
    {
      "id": "line-1",
      "text": "那失去媽媽的疼愛",
      "spelling": "ná sit-khì má-má ê thiànn ài",
      "source_lines": [
        1,
        2
      ]
    },
    {
      "id": "line-4",
      "text": "是人生足大的悲哀",
      "spelling": "sī lîn-sing tsiok tuā ê pi-ai",
      "source_lines": [
        4,
        5
      ]
    },
    {
      "id": "line-7",
      "text": "可比漂流的船隻迷失大海",
      "spelling": "khó-pí phiau-liû ê tsûn-tsiah bê sit tuā-hái",
      "source_lines": [
        7,
        8
      ]
    },
    {
      "id": "line-10",
      "text": "茫茫渺渺那擱遇風颱",
      "spelling": "bông-bông biáu-biáu ná koh tú hong-thai",
      "source_lines": [
        10,
        11
      ]
    },
    {
      "id": "line-13",
      "text": "驚惶的心晟是足無奈",
      "spelling": "kiann-hiânn ê sim tshiânn sī tsiok bô-nāi",
      "source_lines": [
        13,
        14
      ]
    },
    {
      "id": "line-16",
      "text": "大聲叫媽媽妳甘會知",
      "spelling": "tuā-siann kiò má-má lí kam-ē tsai",
      "source_lines": [
        16,
        17
      ]
    },
    {
      "id": "line-19",
      "text": "懷念妳真雜唸的關懷",
      "spelling": "huâi-liām lí tsin tsa̍p-liām ê kuan-huâi",
      "source_lines": [
        19,
        20
      ]
    },
    {
      "id": "line-22",
      "text": "心酸的目屎 滴滴是感慨",
      "spelling": "sim-sng ê ba̍k-sái tih-tih sī kám-khài",
      "source_lines": [
        22,
        23
      ]
    },
    {
      "id": "line-25",
      "text": "無人會凍代替妳的愛",
      "spelling": "bô-lâng ē-tàng tāi-thè lí ê ài",
      "source_lines": [
        25,
        26
      ]
    },
    {
