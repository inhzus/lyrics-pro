{
  "blocks": [
    {
      "id": "line-3",
      "text": "相片內 你的面 寫了滿滿的志氣",
      "spelling": "siòng-phìnn lāi lí ê bīn siá tio̍h muá muá ê tsì-khì",
      "source_lines": [
        3,
        4
      ]
    },
    {
      "id": "line-6",
      "text": "為怎樣現此時 眼神變甲如此空虛",
      "spelling": "uī-tsuánn-iūnn hiān tsú-sî gán-sîn piàn kah tsiah khang-hi",
      "source_lines": [
        6,
        7
      ]
    },
    {
      "id": "line-9",
      "text": "較早的你走去佗位",
      "spelling": "khah-tsá ê lí tsáu-khì tó-uī",
      "source_lines": [
        9,
        10
      ]
    },
    {
      "id": "line-12",
      "text": "是熱情 是條直 予你滿滿的勇氣",
      "spelling": "sī lia̍t-tsîng sī tiâu-ti̍t hōo lí muá muá ê ióng-khì",
      "source_lines": [
        12,
        13
      ]
    },
    {
      "id": "line-15",
      "text": "為怎樣現此時 覕東覕西用心機",
      "spelling": "uī-tsuánn-iūnn hiān tsú-sî bih tang bih sai īng sim-ki",
      "source_lines": [
        15,
        16
      ]
    },
    {
      "id": "line-18",
      "text": "較早的你走去佗位",
      "spelling": "khah-tsá ê lí tsáu-khì tó-uī",
      "source_lines": [
        18,
        19
      ]
    },
    {
      "id": "line-21",
      "text": "最近的我總是定定夢著你",
      "spelling": "tsuè-kīn ê guá tsóng-sī tiānn tiānn bāng tio̍h lí",
      "source_lines": [
        21,
        22
      ]
    },
    {
      "id": "line-24",
      "text": "夢中你像干樂踅啊踅袂停",
      "spelling": "bāng-tiong lí tshiūnn kan-lo̍k se̍h ah se̍h buē-thîng",
      "source_lines": [
        24,
        25
      ]
    },
    {
      "id": "line-27",
      "text": "忽然間發現 我就是你",
      "spelling": "hut-liân kan huat-hiān guá tio̍h sī lí",
      "source_lines": [
        27,
        28
      ]
    },
    {
      "id": "line-30",
      "text": "壁頂彼張舊相片",
      "spelling": "piah-tíng hit tiunn kū siòng-phìnn",
      "source_lines": [
        30,
        31
      ]
    },
    {
      "id": "line-33",
      "text": "青春的證明",
      "spelling": "tshing-tshun ê tsìng-bîng",
      "source_lines": [
        33,
        34
      ]
    },
    {
      "id": "line-36",
      "text": "彼个時陣你的志氣",
      "spelling": "hit ê sî-tsūn lí ê tsì-khì",
      "source_lines": [
        36,
        37
      ]
    },
    {
      "id": "line-39",
      "text": "敢猶閣會記",
      "spelling": "kánn iáu-koh ē kì",
      "source_lines": [
        39,
        40
      ]
    },
    {
      "id": "line-42",
      "text": "壁頂彼張舊相片",
      "spelling": "piah-tíng hit tiunn kū siòng-phìnn",
      "source_lines": [
        42,
        43
      ]
    },
    {
      "id": "line-45",
      "text": "親像咧提醒",
      "spelling": "tshin-tshiūnn leh thê-tshínn",
      "source_lines": [
        45,
        46
      ]
    },
    {
      "id": "line-48",
      "text": "你愛相信 就愛相信",
      "spelling": "lí ài siong-sìn tio̍h ài siong-sìn",
      "source_lines": [
        48,
        49
      ]
    },
    {
      "id": "line-51",
      "text": "咱的夢 永遠遐爾媠",
      "spelling": "lán ê bāng íng-uán hiah-nī suí",
      "source_lines": [
        51,
        52
      ]
    },
    {
      "id": "line-54",
      "text": "牆上那張舊照片",
      "spelling": "piah-tíng hit tiunn kū siòng-phìnn",
      "source_lines": [
        54,
        55
      ]
    },
    {
      "id": "line-57",
