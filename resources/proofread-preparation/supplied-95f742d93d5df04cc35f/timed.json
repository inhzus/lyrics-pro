  "lines": [
    {
      "time": 29.924,
      "text": "揣一個無夢的所在 你敢有佮阮來",
      "kind": "lyric"
    },
    {
      "time": 44.07,
      "text": "過去的孤單無人知 心怎樣疼起來",
      "kind": "lyric"
    },
    {
      "time": 58.17,
      "text": "轉來去故鄉較自在 心嘛會較實在",
      "kind": "lyric"
    },
    {
      "time": 72.29,
      "text": "這馬的人攏無心情 只有你了解我",
      "kind": "lyric"
    },
    {
      "time": 141.111,
      "text": "青春的無奈 你反白的夢",
      "kind": "lyric"
    },
    {
      "time": 147.758,
      "text": "我相信啊你是阮上後的愛",
      "kind": "lyric"
    },
    {
      "time": 154.77,
      "text": "佇困頓的時陣 你佮我相倚",
      "kind": "lyric"
    },
    {
      "time": 161.843,
      "text": "我相信啊這是上好的安排",
      "kind": "lyric"
    },
    {
      "time": 169.367,
      "text": "阮的心 疼甲袂喘氣",
      "kind": "lyric"
    },
    {
      "time": 175.962,
      "text": "想著未來 到底欲走去佗位",
      "kind": "lyric"
    },
    {
      "time": 183.024,
      "text": "佇決定的時 阮袂振袂動",
      "kind": "lyric"
    },
    {
      "time": 190.057,
      "text": "是要怎樣怎樣變成彼個人",
      "kind": "lyric"
    },
    {
      "time": 274.829,
      "text": "佇上課的時陣 你佇我的夢中",
      "kind": "lyric"
    },
    {
      "time": 281.844,
      "text": "佇下課的時陣 咱做伙去海邊",
      "kind": "lyric"
    },
    {
      "time": 289.034,
      "text": "佇散步的時陣 咱兩人佇相偎",
      "kind": "lyric"
    },
    {
      "time": 295.973,
      "text": "佇放蕩的時陣 我佮你做伙",
      "kind": "lyric"
    },
    {
      "time": 303.075,
      "text": "佇上課的時陣 你佇我的夢中",
      "kind": "lyric"
    },
