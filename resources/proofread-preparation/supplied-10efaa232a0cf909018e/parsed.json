{
  "blocks": [
    {
      "id": "line-3",
      "text": "人欲活就愛動",
      "spelling": "lâng be ua̍h tio̍h ài tāng",
      "source_lines": [
        3,
        4
      ]
    },
    {
      "id": "line-6",
      "text": "生活本底就變猴弄",
      "spelling": "sing-ua̍h pún-té tio̍h piàn kâu-lāng",
      "source_lines": [
        6,
        7
      ]
    },
    {
      "id": "line-9",
      "text": "烏魚子就勻勻仔烘",
      "spelling": "oo-hî-tsí tio̍h ûn ûn á hang",
      "source_lines": [
        9,
        10
      ]
    },
    {
      "id": "line-12",
      "text": "齷齪予伊去鑽磅空",
      "spelling": "ok-tshok hōo i khì nǹg pōng-khang",
      "source_lines": [
        12,
        13
      ]
    },
    {
      "id": "line-15",
      "text": "有緣千里嘛會相會",
      "spelling": "ū-iân tshian-lí mah ē siong-huē",
      "source_lines": [
        15,
        16
      ]
    },
    {
      "id": "line-18",
      "text": "斷線的風吹既在伊飛",
      "spelling": "tn̄g suànn ê hong tshue kin tsāi i pue",
      "source_lines": [
        18,
        19
      ]
    },
    {
      "id": "line-21",
      "text": "城市會生疏袂好勢",
      "spelling": "siânn-tshī ē tshenn-sòo buē hó-sè",
      "source_lines": [
        21,
        22
      ]
    },
    {
      "id": "line-24",
      "text": "咱這交會著厝邊頭尾",
      "spelling": "lán tsia kau-huē tio̍h tshù-pinn thâu-bué",
      "source_lines": [
        24,
        25
      ]
    },
    {
      "id": "line-27",
      "text": "丸奇活動中心",
      "spelling": "uân kî ua̍h-tāng tiong-sim",
      "source_lines": [
        27,
        28
      ]
    },
    {
      "id": "line-30",
      "text": "逐家攏嘛歡迎光臨",
      "spelling": "ta̍k-ke lóng mah huān yíng guāng lín",
      "source_lines": [
        30,
        31
      ]
    },
    {
      "id": "line-33",
      "text": "難免一寡不如意",
      "spelling": "lân-bián tsi̍t kuánn put-lû-ì",
      "source_lines": [
        33,
        34
      ]
    },
    {
      "id": "line-36",
      "text": "開講一下隨袂記",
      "spelling": "khai-káng tsi̍t-ē suî bē kì",
      "source_lines": [
        36,
        37
      ]
    },
    {
      "id": "line-39",
      "text": "丸奇活動中心",
      "spelling": "uân kî ua̍h-tāng tiong-sim",
      "source_lines": [
        39,
        40
      ]
    },
    {
      "id": "line-42",
      "text": "好料的攢出來 較要緊",
      "spelling": "hó-liāu ê tshuân tshut-lâi khah iàu-kín",
      "source_lines": [
        42,
        43
      ]
    },
    {
      "id": "line-45",
      "text": "有人佇咧就有閒",
      "spelling": "ū lâng tī leh tio̍h ū-îng",
      "source_lines": [
        45,
        46
      ]
    },
    {
      "id": "line-48",
      "text": "入內盤撋一下 趁心適",
      "spelling": "ji̍p lāi puânn-nuá tsi̍t-ē thàn-sim sik",
      "source_lines": [
        48,
        49
      ]
    },
