  "lines": [
    {
      "time": 0.847,
      "text": "一張白紙 踮在這个彩色世界 變成你佮我",
      "kind": "lyric"
    },
    {
      "time": 13.697,
      "text": "一陣有思想的人 踮在這个現實社會 受環境來拖磨",
      "kind": "lyric"
    },
    {
      "time": 27.795,
      "text": "但是阮知影 路愛家己行",
      "kind": "lyric"
    },
    {
      "time": 32.095,
      "text": "無論這條路上敢有人做伴",
      "kind": "lyric"
    },
    {
      "time": 36.362,
      "text": "但是阮知影 夢愛家己拍拚",
      "kind": "lyric"
    },
    {
      "time": 40.799,
      "text": "無論這條路上 是坎坷抑是孤單",
      "kind": "lyric"
    },
    {
      "time": 49.391,
      "text": "人生這齣電影 就算閣較艱苦嘛愛繼續搬",
      "kind": "lyric"
    },
    {
      "time": 57.993,
      "text": "用咱的跤步 行出屬於咱的路",
      "kind": "lyric"
    },
    {
      "time": 62.542,
      "text": "毋管別人按怎講 按怎看",
      "kind": "lyric"
    },
    {
      "time": 66.748,
      "text": "人生這齣電影 就算閣較艱苦嘛愛繼續搬",
      "kind": "lyric"
    },
    {
