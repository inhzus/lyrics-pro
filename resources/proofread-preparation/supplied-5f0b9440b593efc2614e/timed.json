  "lines": [
    {
      "time": 61.4,
      "text": "一顆心肝亂操操",
      "kind": "lyric"
    },
    {
      "time": 63.99,
      "text": "像是火在燒 水在沖",
      "kind": "lyric"
    },
    {
      "time": 67.38,
      "text": "找不到方法解決",
      "kind": "lyric"
    },
    {
      "time": 70.64,
      "text": "是要叫我怎麼辦",
      "kind": "lyric"
    },
    {
      "time": 74.95,
      "text": "一顆心肝結整坨",
      "kind": "lyric"
    },
    {
      "time": 77.33,
      "text": "親像是繩子綁緊緊 讓人抓緊緊",
      "kind": "lyric"
    },
    {
      "time": 81.29,
      "text": "找不到人來幫忙",
      "kind": "lyric"
    },
    {
      "time": 84.06,
      "text": "是要叫我怎麼辦",
      "kind": "lyric"
    },
    {
      "time": 88.19,
      "text": "有人為了 沒錢在煩惱",
      "kind": "lyric"
    },
    {
      "time": 91.51,
      "text": "有人為了 情人不合煩惱",
      "kind": "lyric"
    },
    {
      "time": 94.73,
      "text": "有人為了 工作在煩惱",
      "kind": "lyric"
    },
    {
      "time": 98.23,
      "text": "有人為了 家庭吵架煩惱",
      "kind": "lyric"
    },
    {
      "time": 101.39,
      "text": "走鐘的人生 跑衝的過程",
      "kind": "lyric"
    },
    {
      "time": 107.04,
      "text": "總是會有不順遂 不要讓人看不起",
      "kind": "lyric"
    },
    {
      "time": 114.76,
      "text": "走鐘的人生 跑衝的過程",
      "kind": "lyric"
    },
    {
      "time": 120.22,
      "text": "總是會有不如意 不要白白來浪費",
      "kind": "lyric"
    },
    {
      "time": 127.54,
      "text": "想要哭 就大聲的哭",
      "kind": "lyric"
    },
    {
      "time": 134.03,
      "text": "哭完 再繼續我們的目標",
      "kind": "lyric"
    },
