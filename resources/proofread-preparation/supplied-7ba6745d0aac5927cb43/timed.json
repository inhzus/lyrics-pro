    },
    {
      "time": 63.01,
      "text": "這樣甘算浪費青春 自己問",
      "kind": "lyric"
    },
    {
      "time": 65.53,
      "text": "用生命 在拚最後一口氣",
      "kind": "lyric"
    },
    {
      "time": 67.93,
      "text": "開的花蕊 這樣才會水 回憶",
