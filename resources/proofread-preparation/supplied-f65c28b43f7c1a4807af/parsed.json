{
  "blocks": [
    {
      "id": "line-1",
      "text": "日頭未光 清吉街景",
      "spelling": "li̍t-thâu buē kng tshinn kiat ke-kíng",
      "source_lines": [
        1,
        2
      ]
    },
    {
      "id": "line-4",
      "text": "迷濛透早 還能小眠",
      "spelling": "bî bâng thàu-tsá iáu thang sió bîn",
      "source_lines": [
        4,
        5
      ]
    },
    {
      "id": "line-7",
      "text": "分散的一天 憶起當時",
      "spelling": "hun-suànn ê tsi̍t kang i̍k-khí tong-sî",
      "source_lines": [
        7,
        8
      ]
    },
    {
      "id": "line-10",
      "text": "早出晚歸 勞累日",
      "spelling": "tsá tshut àm kui lô-thiám li̍t",
      "source_lines": [
        10,
        11
      ]
    },
    {
      "id": "line-13",
      "text": "回頭看自己 風雨打不停",
      "spelling": "ua̍t-thâu khuànn ka-kī hong-hōo phah buē-thîng",
      "source_lines": [
        13,
        14
      ]
    },
    {
      "id": "line-16",
      "text": "收起猶疑 繼續去",
      "spelling": "siu khí tiû-tî kè-sio̍k khì",
      "source_lines": [
        16,
        17
      ]
    },
    {
      "id": "line-19",
      "text": "多少落魄日子 多少擔愁欸時",
      "spelling": "guā-tsē lo̍k-puē li̍t-tsí guā-tsē tann tshiû ê sî",
      "source_lines": [
        19,
        20
      ]
    },
    {
      "id": "line-22",
      "text": "那段傷悲",
      "spelling": "hit tuānn siong pi",
      "source_lines": [
        22,
        23
      ]
    },
    {
      "id": "line-25",
      "text": "多少非歡合離 多少冷暖支持",
      "spelling": "guā-tsē hui huan ha̍h lī guā-tsē líng luán tsi-tshî",
      "source_lines": [
        25,
        26
      ]
    },
    {
      "id": "line-28",
      "text": "層層浮起",
      "spelling": "tîng tîng phû khí",
      "source_lines": [
        28,
        29
      ]
    },
    {
      "id": "line-31",
      "text": "多少落魄日子 多少擔愁欸時",
