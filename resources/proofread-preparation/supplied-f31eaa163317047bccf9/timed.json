  "lines": [
    {
      "time": 27.59,
      "text": "想我一生的運命 親像風吹打斷線",
      "kind": "lyric"
    },
    {
      "time": 41.06,
      "text": "隨風浮沈沒依偎 這山飄浪過彼山",
      "kind": "lyric"
    },
    {
      "time": 55.08,
      "text": "一旦落土低頭看 只存枝骨身已爛",
      "kind": "lyric"
    },
    {
      "time": 69.37,
      "text": "啊 只存枝骨身已爛",
      "kind": "lyric"
    },
    {
      "time": 111.72,
      "text": "花朵再醜也再開一次 偏偏春風等袂來",
      "kind": "lyric"
    },
    {
      "time": 125.72,
      "text": "只要根頭猶原在 不怕枝頭受風颱",
      "kind": "lyric"
    },
    {
      "time": 140.17,
      "text": "誰知花等人採 已經霜降日落西",
      "kind": "lyric"
    },
    {
      "time": 154.06,
      "text": "啊 已經霜降日落西",
      "kind": "lyric"
    },
    {
      "time": 196.24,
      "text": "風吹身軀桂花命 若來想起心就痛",
      "kind": "lyric"
    },
    {
      "time": 210.36,
      "text": "恩怨如煙皆當歡 禍福當作天註定",
      "kind": "lyric"
    },
    {
      "time": 224.41,
      "text": "往事何必回頭看 把它當作夢一般",
      "kind": "lyric"
    },
    {
      "time": 238.36,
      "text": "啊 把它當作夢一般",
      "kind": "lyric"
