{
  "blocks": [
    {
      "id": "line-1",
      "text": "想我一生的運命",
      "spelling": "siūnn guá it-sing ê ūn-miā",
      "source_lines": [
        1,
        2
      ]
    },
    {
      "id": "line-4",
      "text": "親像風吹打斷線",
      "spelling": "tshin-tshiūnn hong tshue phah tn̄g sûn",
      "source_lines": [
        4,
        5
      ]
    },
    {
      "id": "line-7",
      "text": "隨風浮沈沒依偎",
      "spelling": "suî-hong phû-tîm bô i-uá",
      "source_lines": [
        7,
        8
      ]
    },
    {
      "id": "line-10",
      "text": "這山飄浪過彼山",
      "spelling": "tsit suann phiau lōng kuè hit suann",
      "source_lines": [
        10,
        11
      ]
    },
    {
      "id": "line-13",
      "text": "一旦落土低頭看",
      "spelling": "it-tàn lo̍h-thôo lê-thâu khuànn",
      "source_lines": [
        13,
        14
      ]
    },
    {
      "id": "line-16",
      "text": "只存枝骨身已爛",
      "spelling": "tsí tsûn ki kut sin í nuā",
      "source_lines": [
        16,
        17
      ]
    },
    {
      "id": "line-19",
      "text": "啊 只存枝骨身已爛",
      "spelling": "ah tsí tsûn ki kut sin í nuā",
      "source_lines": [
        19,
        20
      ]
    },
    {
      "id": "line-22",
      "text": "花朵再醜也開一次",
      "spelling": "hue-luí koh bái iā khui tsi̍t-pái",
      "source_lines": [
        22,
        23
      ]
    },
    {
      "id": "line-25",
      "text": "偏偏春風等袂來",
      "spelling": "phian phian tshun-hong tán buē lâi",
      "source_lines": [
        25,
        26
      ]
    },
    {
      "id": "line-28",
      "text": "只要根頭猶原在",
      "spelling": "tsí-iàu kun-thâu iu-guân tsāi",
      "source_lines": [
        28,
        29
      ]
    },
    {
      "id": "line-31",
      "text": "不怕枝葉受風颱",
      "spelling": "m̄-kiann ki-hio̍h siū hong-thai",
      "source_lines": [
        31,
        32
      ]
    },
    {
      "id": "line-34",
      "text": "誰知 花等人採",
      "spelling": "siánn-tsai hue tán lâng tshái",
      "source_lines": [
        34,
        35
      ]
    },
    {
      "id": "line-37",
      "text": "已經霜降日落西",
      "spelling": "í-king sng-kàng li̍t-lo̍h sai",
      "source_lines": [
        37,
        38
      ]
    },
    {
      "id": "line-40",
      "text": "啊 已經霜降日落西",
      "spelling": "ah í-king sng-kàng li̍t-lo̍h sai",
      "source_lines": [
        40,
        41
      ]
    },
    {
      "id": "line-43",
      "text": "風吹身軀桂花命",
      "spelling": "hong-tshue sin-khu kuì hue miā",
      "source_lines": [
        43,
        44
      ]
    },
    {
      "id": "line-46",
      "text": "若來想起心就痛",
      "spelling": "ná lâi siūnn-khí sim tio̍h thiànn",
      "source_lines": [
        46,
        47
      ]
    },
    {
      "id": "line-49",
      "text": "恩怨如煙皆當散",
      "spelling": "un-uàn lû ian kai tòng suánn",
      "source_lines": [
        49,
        50
      ]
    },
    {
      "id": "line-52",
      "text": "禍福當作天註定",
      "spelling": "huē hok tòng-tsuè thinn-tsù-tiānn",
      "source_lines": [
        52,
        53
      ]
    },
    {
      "id": "line-55",
      "text": "往事何必回頭看",
      "spelling": "óng-sū hô-pit ua̍t-thâu khuànn",
      "source_lines": [
        55,
        56
      ]
    },
    {
      "id": "line-58",
      "text": "把它當作夢一般",
      "spelling": "kā i tòng-tsuè bāng tsi̍t-puann",
      "source_lines": [
        58,
        59
      ]
    },
    {
      "id": "line-61",
      "text": "啊 把它當作夢一般",
      "spelling": "ah kā i tsuè-tsò bāng tsi̍t-puann",
      "source_lines": [
        61,
        62
      ]
    },
    {
      "id": "line-64",
