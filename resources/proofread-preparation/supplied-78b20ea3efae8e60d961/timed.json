  "lines": [
    {
      "time": 29.99,
      "text": "三月的窗邊 幸福的香味",
      "kind": "lyric"
    },
    {
      "time": 36.93,
      "text": "阮躲置有你的情境",
      "kind": "lyric"
    },
    {
      "time": 43.97,
      "text": "離開已經彼多年 攏無你的消息",
      "kind": "lyric"
    },
    {
      "time": 51.06,
      "text": "你咁有找到你的春天",
      "kind": "lyric"
    },
    {
      "time": 57.35,
      "text": "花開已經過時 不通擱再等你",
      "kind": "lyric"
    },
    {
      "time": 64.23,
      "text": "阮親像袂開的花蕊",
      "kind": "lyric"
    },
    {
      "time": 71.25,
      "text": "青春已經褪了色 還沒人來同情",
      "kind": "lyric"
    },
    {
      "time": 78.44,
      "text": "若愛你 哪通怨恨你",
      "kind": "lyric"
    },
    {
      "time": 87.1,
      "text": "祝福你 平平安安 事事項項順著你的心",
      "kind": "lyric"
    },
    {
      "time": 94.86,
      "text": "愛你的人惦身邊照顧你",
      "kind": "lyric"
    },
    {
      "time": 101.07,
      "text": "祝福我 平平靜靜 一人惦在秋雨的窗邊",
      "kind": "lyric"
    },
    {
      "time": 108.21,
      "text": "若是寂寞的時 會凍不想你",
