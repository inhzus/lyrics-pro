  "lines": [
    {
      "time": 32.88,
      "text": "在二十四這冬 橐袋仔還是空空",
      "kind": "lyric"
    },
    {
      "time": 40.45,
      "text": "舊年生日願望 心內真多的不甘",
      "kind": "lyric"
    },
    {
      "time": 48.0,
      "text": "春夏過又到秋冬 阮閣咧四界探",
      "kind": "lyric"
    },
    {
      "time": 55.61,
      "text": "會曉的无半項 已經有人做狀元",
      "kind": "lyric"
    },
    {
      "time": 78.63,
      "text": "在這二十幾冬 抓袂住的時間",
      "kind": "lyric"
    },
    {
      "time": 86.08,
      "text": "今年生日願望 袂當後悔一世人",
      "kind": "lyric"
    },
    {
      "time": 93.59,
      "text": "春夏過又到秋冬 該還的嘛還完",
      "kind": "lyric"
    },
    {
      "time": 101.32,
      "text": "就算不會半項 嘛欲繼續做眠夢",
      "kind": "lyric"
    },
    {
      "time": 108.88,
      "text": "眠夢阿眠夢 阮攏袂怨嘆",
      "kind": "lyric"
    },
    {
      "time": 116.52,
      "text": "眠夢阿眠夢 阮攏歡喜甘願",
      "kind": "lyric"
    },
    {
      "time": 124.1,
      "text": "這是阮欲行的路 不管有多少阻擋",
      "kind": "lyric"
    },
    {
      "time": 134.16,
      "text": "拳頭掐著嘛要一直向前衝",
      "kind": "lyric"
    },
    {
      "time": 139.39,
      "text": "這是阮欲行的路 不管有多少痛苦",
      "kind": "lyric"
    },
    {
      "time": 149.41,
      "text": "喙根咬來嘛要一直向前衝",
      "kind": "lyric"
