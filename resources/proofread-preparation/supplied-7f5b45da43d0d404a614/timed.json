{
  "recording_id": "lrcapi:1753653081",
  "source": "LrcAPI https://api.lrc.cx/jsonapi?title=%E7%84%A1%E9%A1%8C&artist=%E6%8B%8D%E8%AC%9D%E5%B0%91%E5%B9%B4&album=%E6%B5%B7%E5%8F%A3%E5%91%B3#1753653081",
  "lines": [
    {
      "time": 27.385,
      "text": "我想你已經知影彼兩天",
      "kind": "lyric"
    },
    {
      "time": 32.215,
      "text": "我是決心離開莫閣越頭盼望",
      "kind": "lyric"
    },
    {
      "time": 39.715,
      "text": "是你的執癖 予我袂喘氣啊",
      "kind": "lyric"
    },
    {
      "time": 46.764,
      "text": "咱的生活走精恬恬跋落無聲",
      "kind": "lyric"
    },
    {
      "time": 53.932,
      "text": "是我堅持欲走 你著莫閣姑情",
      "kind": "lyric"
    },
    {
      "time": 61.014,
      "text": "想你講進前的日子 是天星閃爍啊",
      "kind": "lyric"
    },
    {
      "time": 68.21,
      "text": "較早是黏黐黐 啊這馬生份滿滿",
      "kind": "lyric"
    },
    {
      "time": 75.913,
      "text": "扶著我的心肝憂悶遮爾重",
      "kind": "lyric"
    },
    {
      "time": 101.219,
      "text": "是好天氣 做伙散步去",
      "kind": "lyric"
    },
    {
      "time": 108.566,
      "text": "是好天氣 咱做伙散步去",
      "kind": "lyric"
    },
    {
      "time": 115.767,
      "text": "親像開始的時 你講你一定愛去",
      "kind": "lyric"
    },
    {
      "time": 122.26,
      "text": "今仔日又夢醒 輕聲落目屎滴",
      "kind": "lyric"
    },
    {
      "time": 129.517,
      "text": "落雨的暗暝",
      "kind": "lyric"
    },
    {
      "time": 138.016,
      "text": "你那會目箍紅",
      "kind": "lyric"
    },
    {
      "time": 145.311,
      "text": "你那會目箍紅紅",
      "kind": "lyric"
    },
    {
      "time": 152.218,
      "text": "過稀微的生活",
      "kind": "lyric"
    },
    {
      "time": 159.419,
      "text": "是悲傷來強迫",
      "kind": "lyric"
    },
    {
      "time": 167.218,
      "text": "彼當時 用你的批紙紀錄散場的感覺",
      "kind": "lyric"
    },
    {
      "time": 174.86,
      "text": "這齣啊 予命運的風車搧落黑暗的山林",
      "kind": "lyric"
    },
    {
      "time": 182.163,
      "text": "最近的我 已經是無法度 來佮你作伴",
      "kind": "lyric"
    },
    {
      "time": 222.016,
      "text": "你彼段坎坷的線",
      "kind": "lyric"
    },
    {
      "time": 225.166,
      "text": "著算是倔強歸工孔嘴痛",
      "kind": "lyric"
    },
    {
      "time": 229.611,
      "text": "嘛會孤單恬恬看",
      "kind": "lyric"
    },
    {
      "time": 234.918,
      "text": "我離開啥人照顧啊",
      "kind": "lyric"
    },
    {
      "time": 238.169,
      "text": "愛慣習自己坐車提物件",
      "kind": "lyric"
    },
    {
      "time": 242.511,
      "text": "但是無聊欲按怎",
      "kind": "lyric"
    },
    {
      "time": 247.916,
      "text": "驚無人知 你的感覺",
      "kind": "lyric"
    },
    {
      "time": 250.615,
      "text": "惜情的人啊 是一條無尾巷",
      "kind": "lyric"
    },
    {
      "time": 255.316,
      "text": "愛較緊認清看破",
      "kind": "lyric"
    },
    {
      "time": 260.865,
      "text": "驚無人知 你的感覺",
      "kind": "lyric"
    },
    {
      "time": 263.519,
      "text": "惜情的人啊 是一條無尾巷",
      "kind": "lyric"
    },
    {
      "time": 268.369,
      "text": "愛較緊認清看破",
      "kind": "lyric"
    }
  ]
}
