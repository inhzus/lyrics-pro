{
  "blocks": [
    {
      "id": "line-3",
      "text": "今嘛是啥咪情形 塞甲攏看無頭前",
      "spelling": "kim mah sī siánn-mih tsîng-hîng  sat kah lóng khuànn bô thâu-tsîng",
      "source_lines": [
        3,
        4
      ]
    },
    {
      "id": "line-6",
      "text": "庫拉記踩甲強欲抽筋 駛無兩步又擱是紅燈",
      "spelling": "khòo khan kì ta̍h kah kiông beh kiù-kin  sái bô nn̄g pōo iū-koh sī âng-ting",
      "source_lines": [
        6,
        7
      ]
    },
    {
      "id": "line-9",
      "text": "呀無是啥咪情形 有人底抗議遊行",
      "spelling": "ya bô sī siánn-mih tsîng-hîng  ū lâng tí khòng-gī yóuxíng",
      "source_lines": [
        9,
        10
      ]
    },
    {
      "id": "line-12",
      "text": "交通仔比甲是霧煞煞 看破騎鐵馬嘛卡溜抓",
      "spelling": "kau-thong á pí kah sī bū suah suah  khuànn phuà khiâ thih-bé mah khá liù lia̍h",
      "source_lines": [
        12,
        13
      ]
    },
    {
      "id": "line-15",
      "text": "又擱是啥咪情形 副總統欲去吃飯",
      "spelling": "iū-koh sī siánn-mih tsîng-hîng  hù tsóng-thóng beh khì tsia̍h-pn̄g",
      "source_lines": [
        15,
        16
      ]
    },
    {
      "id": "line-18",
      "text": "歸條路攏 伊的場面 阿伯仔氣甲強欲翻面",
      "spelling": "kui tiâu lōo lóng sī i ê tiûnn-bīn  a-peh á khì kah kiông beh píng-pîng",
      "source_lines": [
        18,
        19
      ]
    },
    {
      "id": "line-21",
      "text": "嘿咻！嘿咻！嘿咻！塞車",
      "spelling": "heh siuh！heh siuh！heh siuh！that-tshia",
      "source_lines": [
        21,
