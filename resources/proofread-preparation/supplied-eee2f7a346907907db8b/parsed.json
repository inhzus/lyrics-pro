{
  "blocks": [
    {
      "id": "line-3",
      "text": "日頭照著隨風漂浪的希望",
      "spelling": "li̍t-thâu tshiō-tio̍h suî-hong phiau lōng ê hi-bāng",
      "source_lines": [
        3,
        4
      ]
    },
    {
      "id": "line-6",
      "text": "期待著變成青春的花叢",
      "spelling": "kî-thāi tio̍h piàn-sîng tshing-tshun ê hue-tsâng",
      "source_lines": [
        6,
        7
      ]
    },
    {
      "id": "line-9",
      "text": "就算無情落雨天",
      "spelling": "tsiū-sǹg bô-tsîng lo̍h-hōo-thinn",
      "source_lines": [
        9,
        10
      ]
    },
    {
      "id": "line-12",
      "text": "親像目屎滴",
      "spelling": "tshin-tshiūnn ba̍k-sái tih",
      "source_lines": [
        12,
        13
      ]
    },
    {
      "id": "line-15",
      "text": "重新開始",
      "spelling": "tiông-sin khai-sí",
      "source_lines": [
        15,
        16
      ]
    },
    {
      "id": "line-18",
      "text": "免驚黑暗路看不清",
      "spelling": "bián-kiann oo-àm lōo khuànn-buē-tshing",
      "source_lines": [
        18,
        19
      ]
    },
    {
      "id": "line-21",
      "text": "時間過去 花謝花開",
      "spelling": "sî-kan kuè-khì hue siā hue khui",
      "source_lines": [
        21,
        22
      ]
    },
    {
      "id": "line-24",
      "text": "還是有驕傲的志氣",
      "spelling": "iáu sī ū kiau-ngōo ê tsì-khì",
      "source_lines": [
        24,
        25
      ]
    },
    {
      "id": "line-27",
      "text": "日子過去 變成黑白",
      "spelling": "li̍t-tsí kuè-khì piàn-sîng oo-pe̍h",
      "source_lines": [
        27,
        28
      ]
    },
    {
      "id": "line-30",
      "text": "咱只是暫時來離開",
      "spelling": "lán tsí-sī tsiām-sî lâi lī-khui",
      "source_lines": [
        30,
        31
      ]
    },
    {
      "id": "line-33",
      "text": "免傷悲…",
      "spelling": "bián siong pi",
      "source_lines": [
        33,
        34
      ]
    },
    {
      "id": "line-36",
      "text": "na~~~~~安抓看不清",
      "spelling": "na~~~~~an-tsuánn khuànn-buē-tshing",
