  "source": "LrcAPI https://api.lrc.cx/jsonapi?title=%E8%87%AA%E4%BD%9C%E5%A4%9A%E6%83%85&artist=%E6%B1%9F%E8%95%99&album=%E7%88%B1%E4%BD%9C%E6%A2%A6%E7%9A%84%E9%B1%BC#1444719870",
  "lines": [
    {
      "time": 28.08,
      "text": "今夜的風吹無停",
      "kind": "lyric"
    },
    {
      "time": 34.68,
      "text": "又吹亂城市吵鬧的夜景彼呢冷",
      "kind": "lyric"
    },
    {
      "time": 41.2,
      "text": "想着青春的過程",
      "kind": "lyric"
    },
    {
      "time": 47.7,
      "text": "有真多心酸浮惦阮面前",
      "kind": "lyric"
    },
    {
      "time": 54.36,
      "text": "心愛的人叫袂應",
      "kind": "lyric"
    },
    {
      "time": 60.83,
      "text": "無意愛的人雖然真熱情我不肯",
      "kind": "lyric"
    },
    {
      "time": 67.46,
      "text": "聽見情歌塊叮嚀",
      "kind": "lyric"
    },
    {
      "time": 74.12,
      "text": "原來是痴情已經退流行",
      "kind": "lyric"
    },
    {
      "time": 80.76,
      "text": "啊紛紛擾擾風風雨雨",
      "kind": "lyric"
    },
    {
      "time": 83.75,
      "text": "世事轉啊轉袂停",
      "kind": "lyric"
    },
    {
      "time": 86.68,
      "text": "難免的恩恩怨怨有情夢無情債",
      "kind": "lyric"
    },
    {
      "time": 90.87,
      "text": "早慢我會還",
      "kind": "lyric"
    },
    {
      "time": 93.26,
      "text": "甘願用寂寞交換平靜",
      "kind": "lyric"
    },
    {
      "time": 96.57,
      "text": "不願為名利自作多情",
      "kind": "lyric"
    },
    {
      "time": 100.36,
      "text": "我只有 笑家已 無夠聰明",
      "kind": "lyric"
    },
