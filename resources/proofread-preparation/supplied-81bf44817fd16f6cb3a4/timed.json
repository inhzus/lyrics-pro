  "lines": [
    {
      "time": 64.91,
      "text": "趁這馬根本無你 也無阮的未來",
      "kind": "lyric"
    },
    {
      "time": 70.57,
      "text": "你的心 你的夢才是孤單 你無阮敢會使",
      "kind": "lyric"
    },
    {
      "time": 77.99,
      "text": "你的人真正無通 你黑暗的末來",
      "kind": "lyric"
    },
    {
      "time": 84.69,
      "text": "你的夢真正孤單 你無我敢會使",
      "kind": "lyric"
    },
    {
      "time": 116.49,
      "text": "一個人行袂出來 伊予伊的愛",
      "kind": "lyric"
    },
    {
      "time": 122.62,
      "text": "佇雨落的時陣 你無聲的人",
      "kind": "lyric"
    },
    {
      "time": 129.33,
      "text": "叫是我聽袂出來 你無心答案",
      "kind": "lyric"
    },
    {
      "time": 135.58,
      "text": "你黑暗的未來 阮無聲的夢",
      "kind": "lyric"
    },
    {
      "time": 181.65,
      "text": "趁這馬根本無你 也無阮的未來",
      "kind": "lyric"
    },
    {
      "time": 188.24,
      "text": "你的夢真正孤單 糟蹋阮的期待",
      "kind": "lyric"
    },
    {
      "time": 194.6,
      "text": "你的夢無看現實 閣加咱的未來",
      "kind": "lyric"
    },
    {
      "time": 201.29,
      "text": "希望過新的日子 是啥人的期待",
      "kind": "lyric"
    }
  ]
}
