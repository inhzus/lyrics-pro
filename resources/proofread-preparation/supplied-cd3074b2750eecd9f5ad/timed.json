    {
      "time": 25.94,
      "text": "敢讲这是失去希望的时代？",
      "kind": "lyric"
    },
    {
      "time": 32.24,
      "text": "敢讲这是失去期待的所在？",
      "kind": "lyric"
    },
    {
      "time": 38.59,
      "text": "敢讲咱一世人只有忍耐 只有愤慨 只有无奈",
      "kind": "lyric"
    },
    {
      "time": 45.79,
      "text": "只有目屎无人知 吞落腹肚内",
      "kind": "lyric"
    },
    {
      "time": 51.9,
      "text": "看着心愿慢慢变做毋甘愿",
      "kind": "lyric"
    },
    {
      "time": 57.9,
      "text": "才知期待袂当恬恬仔等待",
      "kind": "lyric"
    },
    {
      "time": 64.13,
      "text": "毋管咱是天才抑是奴才 只有拼着所有气力",
      "kind": "lyric"
    },
    {
      "time": 71.37,
      "text": "挑战无情的世间 一工一冬一世人到永远",
      "kind": "lyric"
    },
    {
      "time": 77.72,
      "text": "一摆阁一摆",
      "kind": "lyric"
    },
    {
      "time": 80.42,
      "text": "毋知影 谁咧安排 命运好歹 一人拢一款",
      "kind": "lyric"
    },
    {
      "time": 87.01,
      "text": "有时阵 想欲放弃 想欲怨叹 想欲流目屎",
      "kind": "lyric"
    },
    {
      "time": 93.35,
      "text": "等一工 乌暗过去 苦尽甘来 人生滋味才了解",
      "kind": "lyric"
    },
    {
      "time": 99.63,
      "text": "为着彼个将来",
      "kind": "lyric"
    },
    {
      "time": 101.17,
      "text": "爱自己 勇敢再勇敢",
      "kind": "lyric"
    },
    {
      "time": 128.14,
      "text": "若有一工 若阮消失伫世间",
