  "lines": [
    {
      "time": 23.81,
      "text": "這段情路 繞呀繞 繞呀繞",
      "kind": "lyric"
    },
    {
      "time": 33.74,
      "text": "女人的夢 天真到徹底 越頭猶原孤一個",
      "kind": "lyric"
    },
    {
      "time": 43.18,
      "text": "你的形影 繞呀繞 繞呀繞",
      "kind": "lyric"
    },
    {
      "time": 52.9,
      "text": "褪色的夢 威置阮心底 紛紛心事亂亂飛",
      "kind": "lyric"
    },
    {
      "time": 64.39,
      "text": "人講人生親像陀螺旋來又旋去",
      "kind": "lyric"
    },
    {
      "time": 70.08,
      "text": "旋袂完的鹹酸甜",
      "kind": "lyric"
    },
    {
      "time": 74.35,
      "text": "阮的思念親像陀螺旋來又旋去",
      "kind": "lyric"
    },
    {
      "time": 79.94,
      "text": "鉆入心肝打袂開",
      "kind": "lyric"
    },
    {
      "time": 83.99,
      "text": "你是窗外秋天的雨來來又去去",
      "kind": "lyric"
    },
    {
      "time": 89.54,
      "text": "愛阮傷阮同一暝",
      "kind": "lyric"
    },
    {
      "time": 93.61,
      "text": "才知阮是你的陀螺飛出感情的線",
      "kind": "lyric"
    },
    {
      "time": 99.79,
      "text": "跌落土腳旋歸暝",
      "kind": "lyric"
