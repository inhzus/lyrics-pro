{
  "blocks": [
    {
      "id": "line-3",
      "text": "他們講伊那麼美麗",
      "spelling": "in kóng i hiah-nī bí-lē",
      "source_lines": [
        3,
        4
      ]
    },
    {
      "id": "line-6",
      "text": "嘴唇半開伊攏沒講話",
      "spelling": "tshuì tûn puànn khui i lóng bô kóng-uē",
      "source_lines": [
        6,
        7
      ]
    },
    {
      "id": "line-9",
      "text": "走路姿勢 迷人身體",
      "spelling": "kiânn-lōo tsu-sè bî-lâng sin-thé",
      "source_lines": [
        9,
        10
      ]
    },
    {
      "id": "line-12",
      "text": "短裙 高跟鞋 展腳腿",
      "spelling": "té-kûn kuân-ta̍h tián kha thuí",
      "source_lines": [
        12,
        13
      ]
    },
    {
      "id": "line-15",
      "text": "伊甘真正有那麼美麗",
      "spelling": "i kam tsin-tsiànn ū hiah-nī bí-lē",
      "source_lines": [
        15,
        16
      ]
    },
    {
      "id": "line-18",
      "text": "大家攏想要跟伊講話",
      "spelling": "ta̍k-ke lóng siūnn beh kā i kóng-uē",
      "source_lines": [
        18,
        19
      ]
    },
    {
      "id": "line-21",
      "text": "無辜眼神 使人多怨懟",
      "spelling": "bô-koo gán-sîn sú lâng ke uàn te",
      "source_lines": [
        21,
        22
      ]
    },
    {
      "id": "line-24",
      "text": "因為美麗之下是查埔身",
      "spelling": "in-uī bí-lē tsi-hā sī tsa-poo sin",
      "source_lines": [
        24,
        25
      ]
    },
    {
      "id": "line-27",
      "text": "黑暗中的美麗 誰人可以體會",
      "spelling": "oo-àm tiong ê bí-lē siánn-lâng ē-tàng thé-kuē",
      "source_lines": [
        27,
        28
      ]
    },
    {
      "id": "line-30",
      "text": "只要你一句話",
      "spelling": "tsí-iàu lí tsi̍t kù-uē",
      "source_lines": [
        30,
        31
      ]
    },
    {
      "id": "line-33",
      "text": "阮就付出到徹底",
      "spelling": "gún tio̍h hù-tshut kah thiat-té",
      "source_lines": [
        33,
        34
      ]
    },
    {
      "id": "line-38",
      "text": "心內話講賣出嘴",
      "spelling": "sim-lāi uē kóng bē tshut tshuì",
      "source_lines": [
        38,
        39
      ]
    },
    {
      "id": "line-41",
      "text": "將阮个 心放抵手底",
      "spelling": "tsiòng gún ê sim khǹg tshiú-té",
      "source_lines": [
        41,
        42
      ]
    },
