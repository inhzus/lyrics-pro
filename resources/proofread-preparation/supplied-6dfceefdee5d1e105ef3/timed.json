    {
      "time": 37.77,
      "text": "甲汝搖甲汝惜 甲汝當作一個寶",
      "kind": "lyric"
    },
    {
      "time": 44.09,
      "text": "甲汝疼甲汝抱 汝是阮的小朋友",
      "kind": "lyric"
    },
    {
      "time": 50.69,
      "text": "今仔日明仔載 永遠健康擱快樂",
      "kind": "lyric"
    },
    {
      "time": 56.89,
      "text": "無憂愁無煩惱 以後帶汝去打棒球",
      "kind": "lyric"
    },
    {
      "time": 64.02,
      "text": "嬰仔嬰嬰困 一眠大一吋",
      "kind": "lyric"
    },
    {
      "time": 76.63,
      "text": "嬰仔嬰嬰秀 一眠大一尺",
      "kind": "lyric"
    },
    {
      "time": 113.68,
      "text": "汝若無乖 我會甲汝罵",
      "kind": "lyric"
    },
    {
      "time": 117.05,
      "text": "汝若無款 阮會甲汝打",
      "kind": "lyric"
    },
    {
      "time": 120.14,
      "text": "寵子不孝 寵豬舉灶",
      "kind": "lyric"
    },
    {
      "time": 123.2,
      "text": "打到汝的手 疼到阮心內",
