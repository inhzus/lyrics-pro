  "lines": [
    {
      "time": 0,
      "text": "作曲 : 萧煌奇",
      "kind": "credit"
    },
    {
      "time": 1.0,
      "text": "作词 : 武雄",
      "kind": "credit"
    },
    {
      "time": 26.63,
      "text": "彼一年寒冷的冬天寒流来的时",
      "kind": "lyric"
    },
    {
      "time": 29.01,
      "text": "彼一暝　伊对梦中雄雄惊醒",
      "kind": "lyric"
    },
    {
      "time": 33.45,
      "text": "靴管笼落去　袄仔幔落去",
      "kind": "lyric"
    },
    {
      "time": 36.63,
      "text": "欲去海边巡鱼池",
      "kind": "lyric"
    },
    {
      "time": 40.03,
      "text": "伊讲伊的虱目鱼拢无臭土味",
      "kind": "lyric"
    },
    {
      "time": 41.96,
      "text": "真值钱　但是上惊这款天气",
      "kind": "lyric"
    },
    {
      "time": 46.59,
      "text": "若是小可无注意　今年就免想过年",
      "kind": "lyric"
    },
    {
      "time": 56.51,
      "text": "伊怨叹客厅内归暗看电视",
      "kind": "lyric"
    },
    {
      "time": 60.01,
      "text": "月初嘟退伍的囝儿",
      "kind": "lyric"
    },
    {
      "time": 63.32,
      "text": "叫伊斗阵去　伊嘛无愿意",
      "kind": "lyric"
    },
    {
      "time": 66.64,
      "text": "因为粗重的头路伊无趣味",
      "kind": "lyric"
    },
    {
      "time": 70.31,
      "text": "伊讲无论虱目鱼世界好滋味",
      "kind": "lyric"
    },
    {
      "time": 72.3,
      "text": "有外甜　嘛是乎人嫌相多幼刺",
      "kind": "lyric"
    },
    {
      "time": 76.43,
      "text": "青春少年时　就爱靠家己",
      "kind": "lyric"
    },
    {
      "time": 79.7,
      "text": "惦庄脚所在赚袂着钱",
      "kind": "lyric"
    },
    {
      "time": 83.08,
      "text": "伊才会决定愈离开决定飞上天",
      "kind": "lyric"
    },
    {
      "time": 85.65,
      "text": "去城市　不管序大人按怎好嘴",
      "kind": "lyric"
    },
    {
      "time": 89.71,
      "text": "伊欲赚鱼翅　无爱捡鱼刺",
      "kind": "lyric"
    },
    {
      "time": 93.17,
      "text": "为着将来赚大钱　只要将来赚大钱",
      "kind": "lyric"
    },
    {
      "time": 98.43,
      "text": "管汰伊　阿爸的虱目鱼",
      "kind": "lyric"
    },
    {
      "time": 104.56,
      "text": "......",
      "kind": "lyric"
    },
    {
      "time": 113.34,
      "text": "彼一年彼场风台雨淹过彼条路",
      "kind": "lyric"
    },
    {
      "time": 115.77,
      "text": "彼下晡　伊向天公伯叹一口气",
      "kind": "lyric"
    },
    {
      "time": 120.09,
      "text": "不听别人的阻止　铁马骑出去",
      "kind": "lyric"
    },
    {
      "time": 124.1,
      "text": "欲去巡鱼池",
      "kind": "lyric"
    },
    {
      "time": 126.96,
      "text": "伊讲伊的虱目鱼真用心来饲",
      "kind": "lyric"
    },
    {
      "time": 129.02,
      "text": "当值钱　偏偏遇到这款天气",
      "kind": "lyric"
    },
    {
      "time": 133.37,
      "text": "如今水拢加淹去　满街路四界拢是",
      "kind": "lyric"
    },
    {
      "time": 143.18,
      "text": "伊怨叹伊家己为着虱目鱼",
      "kind": "lyric"
    },
    {
      "time": 146.74,
      "text": "连后生拢赶赶出去",
      "kind": "lyric"
    },
    {
      "time": 149.93,
      "text": "只剩一个人　行到水池边",
      "kind": "lyric"
    },
    {
      "time": 153.36,
      "text": "面前的一切也已经拢无意义",
      "kind": "lyric"
    },
    {
      "time": 156.88,
      "text": "伊讲无论虱目鱼世界好滋味",
      "kind": "lyric"
    },
    {
      "time": 158.76,
      "text": "有外甜　嘛是需要顶面的支持",
      "kind": "lyric"
    },
    {
      "time": 163.07,
      "text": "饲料彼呢贵　又搁歹景气",
      "kind": "lyric"
    },
    {
      "time": 166.38,
      "text": "渔会的政策拢荒废",
      "kind": "lyric"
    },
    {
      "time": 169.65,
      "text": "伊看见水淹彼呢淀四界拢嘛是",
      "kind": "lyric"
    },
    {
      "time": 172.53,
      "text": "伊的鱼　亲像是开嘴咧叫伊",
      "kind": "lyric"
    },
    {
      "time": 176.4,
      "text": "叫伊紧放弃　叫伊紧返去",
      "kind": "lyric"
    },
    {
      "time": 179.72,
      "text": "伊讲伊有听见",
      "kind": "lyric"
    },
    {
      "time": 183.01,
      "text": "伊讲伊有看见彼暝的梦中的虱目鱼",
      "kind": "lyric"
    },
    {
      "time": 192.93,
      "text": "......",
      "kind": "lyric"
    },
    {
      "time": 213.45,
      "text": "听讲彼暗的电视",
      "kind": "lyric"
    },
    {
      "time": 214.74,
      "text": "拢有报到伊　的名字",
      "kind": "lyric"
    },
    {
      "time": 216.99,
      "text": "无人知最后伊流去叨位",
      "kind": "lyric"
    },
    {
      "time": 219.74,
      "text": "新闻足讽刺　画面足趣味",
      "kind": "lyric"
    },
    {
      "time": 223.06,
      "text": "有人惦马路块捞鱼",
      "kind": "lyric"
    },
    {
      "time": 226.49,
      "text": "伊彼个　城市的后生",
      "kind": "lyric"
    },
    {
      "time": 228.18,
      "text": "警察来通知彼当时",
      "kind": "lyric"
    },
    {
      "time": 230.05,
      "text": "饮茫茫惦路边甲人相争",
      "kind": "lyric"
    },
    {
      "time": 233.15,
      "text": "伊讲虱目鱼　其实拢无刺",
      "kind": "lyric"
    },
    {
      "time": 236.4,
      "text": "人讲伊已经醉　伊讲伊无骗你",
      "kind": "lyric"
    },
    {
      "time": 241.45,
      "text": "虱目鱼　原本是　伊的名字",
      "kind": "lyric"
    },
    {
      "time": 251.57,
      "text": "",
      "kind": "gap"
    },
    {
      "time": 257.39,
      "text": "--=End=--",
