{
  "blocks": [
    {
      "id": "line-4",
      "text": "失去希望的感覺",
      "spelling": "sit-khì hi-bāng ê kám-kak",
      "source_lines": [
        4,
        5
      ]
    },
    {
      "id": "line-7",
      "text": "無人會當講出喙",
      "spelling": "bô-lâng ē-tàng kóng-tshut tshuì",
      "source_lines": [
        7,
        8
      ]
    },
    {
      "id": "line-10",
      "text": "想欲講的有偌濟",
      "spelling": "siūnn-beh kóng ē ū guā-tsē",
      "source_lines": [
        10,
        11
      ]
    },
    {
      "id": "line-13",
      "text": "猶原袂當放予去",
      "spelling": "iu-guân buē-tàng pàng hōo khì",
      "source_lines": [
        13,
        14
      ]
    },
    {
      "id": "line-16",
      "text": "想著細漢的時陣",
      "spelling": "siūnn-tio̍h sè-hàn ê sî-tsūn",
      "source_lines": [
        16,
        17
      ]
    },
    {
      "id": "line-19",
      "text": "做伙鬥陣的感覺",
      "spelling": "tsò-hué tàu-tīn ê kám-kak",
      "source_lines": [
        19,
        20
      ]
    },
    {
      "id": "line-22",
      "text": "彼個暗暝講袂停",
      "spelling": "hit-ê e-àm kóng buē thîng",
      "source_lines": [
        22,
        23
      ]
    },
    {
      "id": "line-25",
      "text": "講出將來的願望",
      "spelling": "kóng-tshut tsiong-lâi ê guān-bōng",
      "source_lines": [
        25,
        26
      ]
    },
    {
      "id": "line-28",
      "text": "伊想著過去彼當時",
      "spelling": "i siūnn-tio̍h kuè-khì hit tong-sî",
      "source_lines": [
        28,
        29
      ]
    },
    {
      "id": "line-31",
      "text": "親像野鳥欲飛出巢",
      "spelling": "tshiūnn iá-tsiáu bē pue-tshut siū",
      "source_lines": [
        31,
        32
      ]
    },
    {
      "id": "line-34",
      "text": "看著外面的世界",
      "spelling": "khuànn-tio̍h guā-bīn ê sè-kài",
      "source_lines": [
        34,
        35
      ]
    },
    {
      "id": "line-37",
      "text": "相信家己會堅強",
      "spelling": "siong-sìn ka-kī ē kian-kiông",
      "source_lines": [
        37,
        38
      ]
    },
    {
      "id": "line-40",
      "text": "只要家己相信著會當解決一切行落去",
      "spelling": "tsí-iàu ka-kī siong-sìn tio̍h ē-tàng kái-kuat it-tshè kiânn lue-khì",
      "source_lines": [
        40,
        41
      ]
    },
    {
      "id": "line-43",
      "text": "混亂世界的問題放予一切攏予風吹去",
      "spelling": "hūn-luān sè-kài ê būn-tê pàng hōo it-tshè lóng hōo hong-tshue khì",
      "source_lines": [
        43,
        44
      ]
    },
    {
      "id": "line-46",
      "text": "親像別人咧講 聽著別人咧講",
      "spelling": "tshin-tshiūnn pa̍t-lâng leh kóng thiann-tio̍h pa̍t-lâng leh kóng",
      "source_lines": [
        46,
        47
      ]
    },
    {
      "id": "line-49",
      "text": "為著別人的性命活落去",
      "spelling": "uī-tio̍h pa̍t-lâng ê sinn-miā ua̍h lue-khì",
      "source_lines": [
        49,
        50
      ]
    },
    {
      "id": "line-52",
      "text": "你著想予清楚",
      "spelling": "lí tio̍h siūnn hōo tshing-tshó",
      "source_lines": [
        52,
        53
      ]
    },
    {
      "id": "line-55",
      "text": "人生只有一擺",
      "spelling": "lîn-sing tsí-ū tsi̍t-pái",
      "source_lines": [
        55,
        56
      ]
    },
    {
      "id": "line-58",
      "text": "袂當放予一切一切重頭來",
      "spelling": "buē-tàng pàng hōo it-tshè it-tshè tîng-thâu lâi",
      "source_lines": [
        58,
        59
      ]
    },
    {
      "id": "line-61",
      "text": "青春時，毋通過甲傷心",
      "spelling": "tshing-tshun-sî m̄-thang kuè kam siong-sim",
      "source_lines": [
        61,
        62
      ]
    },
    {
      "id": "line-64",
      "text": "失去的希望，這馬踮你的心",
      "spelling": "sit-khì ê hi-bāng tsit-má tiam lí ê sim",
      "source_lines": [
        64,
        65
      ]
    },
    {
      "id": "line-67",
      "text": "少年人，莫閣浪費人生",
      "spelling": "siàu-liân-lâng mài koh lōng-huì lîn-sing",
      "source_lines": [
        67,
        68
      ]
    },
    {
      "id": "line-70",
      "text": "失去的日子，這馬踮阮的心",
      "spelling": "sit-khì ê li̍t-tsí tsit-má tiam gún ê sim",
      "source_lines": [
        70,
        71
      ]
    },
    {
      "id": "line-73",
      "text": "混亂的一生",
      "spelling": "hūn-luān ê it-sing",
      "source_lines": [
        73,
        74
      ]
    },
    {
      "id": "line-76",
      "text": "唱了你這條歌",
      "spelling": "tshiùnn liáu lí tsit-tiâu kua",
      "source_lines": [
        76,
        77
      ]
    },
    {
      "id": "line-79",
      "text": "簡單的希望",
      "spelling": "kán-tan ê hi-bāng",
      "source_lines": [
        79,
        80
      ]
    },
    {
      "id": "line-82",
      "text": "夢中鬥陣來搬",
      "spelling": "bāng-tiong tàu-tīn lâi puann",
      "source_lines": [
        82,
        83
      ]
    },
    {
      "id": "line-85",
      "text": "青春的沈重",
      "spelling": "tshing-tshun ê tîm-tāng",
      "source_lines": [
        85,
        86
      ]
    },
    {
      "id": "line-88",
      "text": "唱甲遐爾大聲",
      "spelling": "tshiùnn kam hiah-nī tuā-siann",
      "source_lines": [
        88,
        89
      ]
    },
    {
      "id": "line-91",
      "text": "最後～攏予去",
      "spelling": "tsuè-āu～lóng hōo khì",
      "source_lines": [
        91,
        92
      ]
    }
  ],
  "credits": [
    {
      "line": 2,
      "text": "作詞：薑薑 作曲：拍謝少年 台羅拼音：關德樂"
    }
  ],
