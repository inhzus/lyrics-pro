    {
      "id": "line-3",
      "text": "冬天的風吹來冷冷的雨",
      "spelling": "tang-thinn ê hong-tshue lâi líng líng ê hōo",
      "source_lines": [
        3,
        4
      ]
    },
    {
      "id": "line-6",
      "text": "頭厘厘找不到來時的路",
      "spelling": "thâu lî lî tshuē buē tio̍h lâi sî ê lōo",
      "source_lines": [
        6,
        7
      ]
    },
    {
      "id": "line-9",
      "text": "青紅燈閃爍著我的無助",
      "spelling": "tshenn âng-ting siám-sih tio̍h guá ê bô tsōo",
      "source_lines": [
        9,
        10
      ]
    },
    {
      "id": "line-12",
      "text": "安怎會走到這地步",
      "spelling": "uī-tsuánn-iūnn kiânn-kàu tse tē-pōo",
      "source_lines": [
        12,
        13
      ]
    },
    {
