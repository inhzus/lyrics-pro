      "kind": "gap"
    },
    {
      "time": 21.83,
      "text": "突然间有一阵冷风吹来",
      "kind": "lyric"
    },
    {
      "time": 26.2,
      "text": "才知影原来思念犹原 卷底心肝内",
      "kind": "lyric"
    },
    {
      "time": 34.72,
      "text": "月台边情人双双对对",
      "kind": "lyric"
    },
    {
      "time": 38.95,
      "text": "目睭内甜蜜像针威",
      "kind": "lyric"
    },
    {
      "time": 45.67,
      "text": "咁是你已将约束放袂记",
      "kind": "lyric"
    },
    {
      "time": 49.91,
      "text": "冷风像知我无人安慰 替阮哮归暝",
      "kind": "lyric"
    },
    {
      "time": 58.56,
      "text": "为按怎我拢袂清醒",
      "kind": "lyric"
    },
    {
      "time": 62.84,
      "text": "到如今犹原放袂开",
      "kind": "lyric"
    },
    {
      "time": 67.12,
      "text": "一个人拉着感情线",
      "kind": "lyric"
    },
    {
      "time": 71.98,
      "text": "行越远越孤单",
      "kind": "lyric"
    },
    {
      "time": 77.84,
      "text": "思念哪亲像点袂着的番仔火",
      "kind": "lyric"
    },
    {
      "time": 82.39,
      "text": "免等到风吹 早已经有魂无体",
      "kind": "lyric"
    },
    {
      "time": 86.51,
      "text": "对你的痴心 伤心 搁剩彼多",
      "kind": "lyric"
    },
    {
      "time": 90.91,
      "text": "卡多嘛无人可体会",
      "kind": "lyric"
    },
    {
      "time": 95.24,
      "text": "缘份哪亲像点袂着的番仔火",
      "kind": "lyric"
    },
    {
      "time": 99.49,
      "text": "越点越心酸 越爱越袂冻作伙",
      "kind": "lyric"
    },
    {
      "time": 104.07,
      "text": "若不是想你 想甲 无路可退",
      "kind": "lyric"
    },
    {
      "time": 108.26,
      "text": "也袂留给你有机会 伤阮彻底",
      "kind": "lyric"
    },
    {
