  "source": "User-supplied resources/lyrics-spelling/飲水思源-蕭煌奇",
  "blocks": [
    {
      "id": "line-1",
      "text": "想起初次來到夜都市",
      "spelling": "siūnn-khí tshoo tshù lâi kàu iā too-tshī",
      "source_lines": [
        1,
        2
      ]
    },
    {
      "id": "line-4",
      "text": "街燈閃爍心稀微",
      "spelling": "ke-ting siám-sih sim hi-bî",
      "source_lines": [
        4,
        5
      ]
    },
    {
      "id": "line-7",
      "text": "離開故鄉到底為什麼",
      "spelling": "lī-khui kòo-hiong tàu-té uī-siánn-mi̍h",
      "source_lines": [
        7,
        8
      ]
    },
    {
      "id": "line-10",
      "text": "阮嘛唔敢來將伊放袂記",
      "spelling": "gún mā m̄-kánn lâi tsiòng i pàng buē kì",
      "source_lines": [
        10,
        11
      ]
    },
    {
      "id": "line-13",
      "text": "青春美夢 有你疼痛",
      "spelling": "tshing-tshun bí-bāng ū lí thiànn-thàng",
      "source_lines": [
        13,
        14
      ]
    },
    {
      "id": "line-16",
      "text": "阮唔驚路途多遙遠",
      "spelling": "gún m̄-kiann lōo-tôo luā iâu-uán",
      "source_lines": [
        16,
        17
      ]
    },
    {
      "id": "line-19",
      "text": "青春美夢 心頭若沉重",
      "spelling": "tshing-tshun bí-bāng sim-thâu ná tîm-tāng",
      "source_lines": [
        19,
        20
      ]
    },
    {
      "id": "line-22",
      "text": "唔甘乎你來操煩",
      "spelling": "m̄-kam hōo lí lâi tshau-huân",
      "source_lines": [
        22,
        23
      ]
    },
    {
      "id": "line-25",
      "text": "故鄉的人 阮日日夜夜夢",
      "spelling": "kòo-hiong ê lâng gún ji̍t-ji̍t-iā-iā bāng",
      "source_lines": [
        25,
        26
      ]
    },
    {
      "id": "line-28",
      "text": "咱唔驚風雨淋 唔驚日頭曬",
      "spelling": "lán m̄-kiann hong-hōo lâm m̄-kiann ji̍t-thâu pha̍k",
      "source_lines": [
        28,
        29
      ]
    },
    {
      "id": "line-31",
      "text": "愛你的人 塊為你期待為你等",
      "spelling": "ài lí ê lâng tè uî lí kî-thāi uî lí tán",
      "source_lines": [
        31,
        32
      ]
    },
    {
      "id": "line-34",
      "text": "攬著希望 飲水思源",
      "spelling": "lám-tio̍h hi-bāng im tsuí su guân",
      "source_lines": [
        34,
        35
      ]
    },
    {
      "id": "line-37",
      "text": "返來ㄟ一工",
      "spelling": "tńg-lâi ê tsi̍t kang",
      "source_lines": [
        37,
        38
      ]
    },
    {
      "id": "line-40",
      "text": "感謝身邊所有愛我的人",
      "spelling": "kám-siā sin-pinn sóo-iú ài guá ê lâng",
      "source_lines": [
        40,
        41
      ]
    },
    {
      "id": "line-43",
      "text": "你的鼓勵乎我真溫暖",
      "spelling": "lí ê kóo-lē hōo guá tsin un-luán",
      "source_lines": [
        43,
        44
      ]
    },
    {
      "id": "line-46",
      "text": "當初的堅持到底為什麼",
      "spelling": "tong-tshoo ê kian-tshî tàu-té uī-siánn-mi̍h",
      "source_lines": [
        46,
        47
      ]
    },
    {
