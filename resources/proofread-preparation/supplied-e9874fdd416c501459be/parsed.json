        {
          "text": "哪會變安呢生",
          "spelling": "ná ē piàn an-nî sing"
        }
      ]
    },
    {
      "id": "line-16",
      "text": "風微微想到汝",
      "spelling": "hong bî bî siūnn-tio̍h lí",
      "source_lines": [
        16,
        17
      ]
    },
    {
      "id": "line-19",
      "text": "放浪的人生 放蕩的時                              看著我身軀刺的字",
      "spelling": "hòng lōng ê lîn-sing  hòng-tōng ê sî   khuànn-tio̍h guá sin-khu tshiah ê gī",
      "source_lines": [
        19,
        20
      ]
    },
