{
  "blocks": [
    {
      "id": "line-1",
      "text": "無聊的暗暝 無聊的時                           汝會來離開阮身邊",
      "spelling": "bô-liâu ê àm mî  bô-liâu ê sî            lí ē lâi lī-khui gún sin-pinn",
      "source_lines": [
        1,
        2
      ]
    },
    {
      "id": "line-4",
      "text": "嘛已經歸落年",
      "spelling": "mā í-king kui lo̍h nî",
      "source_lines": [
        4,
        5
      ]
    },
    {
      "id": "line-7",
      "text": "無啥咪代誌 嘛無啥稀奇                                     看抉破離抉開的人",
      "spelling": "bô siánn-mih tāi-tsì mā bô siánn hi-kî        khuànn bē phuà lī bē khui ē lâng",
      "source_lines": [
        7,
        8
      ],
      "parts": [
        {
          "text": "無啥咪代誌 嘛無啥稀奇",
          "spelling": "bô siánn-mih tāi-tsì mā bô siánn hi-kî"
        },
        {
          "text": "看抉破離抉開的人",
          "spelling": "khuànn bē phuà lī bē khui ē lâng"
        }
      ]
    },
    {
      "id": "line-10",
      "text": "是痛苦的開始",
      "spelling": "sī thòng-khóo ê khai-sí",
      "source_lines": [
        10,
        11
      ]
    },
    {
      "id": "line-13",
      "text": "嘸知汝治叨位                  哪會變安呢生",
      "spelling": "m̄ tsai lí tī tó-uī             ná ē piàn an-nî sing",
      "source_lines": [
        13,
        14
      ],
      "parts": [
        {
          "text": "嘸知汝治叨位",
          "spelling": "m̄ tsai lí tī tó-uī"
