  "lines": [
    {
      "time": 24.0,
      "text": "還記得那當準 聽到林強的向前走",
      "kind": "lyric"
    },
    {
      "time": 28.68,
      "text": "阮來到台北車站",
      "kind": "lyric"
    },
    {
      "time": 32.834,
      "text": "聽人講啥咪好康的攏底這 甘有真正 甘有影",
      "kind": "lyric"
    },
    {
      "time": 43.288,
      "text": "在台北整牙當 對狼在摸弄拉",
      "kind": "lyric"
    },
    {
      "time": 47.671,
      "text": "回去故鄉 阿爸甲阮講 猴嗯這安呢",
      "kind": "lyric"
    },
    {
      "time": 53.307,
      "text": "伊講 林北太久沒甲你教訓 你不知林北鞋子穿幾號",
      "kind": "lyric"
    },
    {
      "time": 62.58,
      "text": "台北 台北 你甘有聽到 阮鄉下囝仔的心聲",
      "kind": "lyric"
    },
    {
      "time": 72.049,
      "text": "台北 台北 台北 台北 阮毋驚吃苦 也認真打拼",
      "kind": "lyric"
    },
    {
      "time": 81.759,
      "text": "台北 台北 你甘有聽到 阮鄉下囝仔的心聲",
      "kind": "lyric"
    },
    {
      "time": 90.422,
      "text": "阮為著啥 是為著啥",
      "kind": "lyric"
    },
    {
      "time": 95.241,
      "text": "是為著厝內有等阮回去的爸爸媽媽",
      "kind": "lyric"
    },
    {
      "time": 104.284,
      "text": "擱有阿公阿嬤 老朋友老親戚",
      "kind": "lyric"
    },
    {
      "time": 114.309,
      "text": "請恁就耐心等待 阮成功的那一天",
      "kind": "lyric"
    },
    {
