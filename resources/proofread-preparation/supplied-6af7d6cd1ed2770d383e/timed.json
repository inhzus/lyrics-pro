    {
      "time": 4.73,
      "text": "每一個人的夢中 攏有一扇門",
      "kind": "lyric"
    },
    {
      "time": 8.94,
      "text": "有的人開門 是欲飛向遙遠的未來",
      "kind": "lyric"
    },
    {
      "time": 12.96,
      "text": "有的人開門 是為著懷念囝仔時代",
      "kind": "lyric"
    },
    {
      "time": 16.99,
      "text": "阮的夢中嘛有一扇門 每一次打開",
      "kind": "lyric"
    },
    {
      "time": 22.48,
      "text": "就會帶我返去 上思念的所在",
      "kind": "lyric"
    },
    {
      "time": 35.9,
      "text": "上愛看到月光 偷偷照入門",
      "kind": "lyric"
    },
    {
      "time": 43.99,
      "text": "陪阮想啊 陪阮夢啊 陪阮倒踮眠床",
      "kind": "lyric"
    },
    {
      "time": 51.96,
      "text": "思思念念的人 想著心就軟",
      "kind": "lyric"
    },
    {
      "time": 60.04,
      "text": "置海角啊 置天邊啊 置阮夢中央",
      "kind": "lyric"
    },
    {
      "time": 67.0,
      "text": "一慕離情 擦溼雙邊的手袖",
      "kind": "lyric"
    },
    {
      "time": 75.1,
      "text": "兩掛珍珠 點點滴滴攏打斷",
      "kind": "lyric"
    },
    {
      "time": 82.83,
      "text": "三更露深 夜夜思念到天光",
      "kind": "lyric"
    },
    {
      "time": 91.1,
      "text": "唉呦喂 你離我彼呢遠",
      "kind": "lyric"
    },
    {
      "time": 120.06,
      "text": "上驚看無月光 開窗一直問",
      "kind": "lyric"
    },
    {
      "time": 128.09,
      "text": "問過去啊 問以後啊 問阮怎樣按算",
      "kind": "lyric"
    },
    {
      "time": 135.97,
      "text": "思思念念的人 催阮緊來返",
      "kind": "lyric"
