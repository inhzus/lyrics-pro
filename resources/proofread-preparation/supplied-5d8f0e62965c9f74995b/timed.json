  "lines": [
    {
      "time": 21.349,
      "text": "回頭看那段青春的路程",
      "kind": "lyric"
    },
    {
      "time": 26.297,
      "text": "你想起離開的時候",
      "kind": "lyric"
    },
    {
      "time": 30.741,
      "text": "傻傻坐上那班夜車",
      "kind": "lyric"
    },
    {
      "time": 33.64,
      "text": "開始奔走的人生",
      "kind": "lyric"
    },
    {
      "time": 38.04,
      "text": "渾沌的青春",
      "kind": "lyric"
    },
    {
      "time": 41.597,
      "text": "還有你軟弱的個性",
      "kind": "lyric"
    },
    {
      "time": 45.99,
      "text": "點起手上又一支菸",
      "kind": "lyric"
    },
    {
      "time": 49.794,
      "text": "眼淚流不停",
      "kind": "lyric"
    },
    {
      "time": 69.244,
      "text": "你說人生呀人生 像飄浪海上的船",
      "kind": "lyric"
    },
    {
      "time": 78.199,
      "text": "有時風吹起陣陣風湧 運命總是捉摸不定",
      "kind": "lyric"
    },
    {
      "time": 86.29,
      "text": "抬頭看遙遠的天上",
      "kind": "lyric"
    },
    {
      "time": 88.893,
      "text": "笑看這浮沉風景",
      "kind": "lyric"
    },
    {
      "time": 94.041,
      "text": "就算要等待一生",
      "kind": "lyric"
    },
    {
      "time": 96.163,
      "text": "也要活得沒有怨恨",
      "kind": "lyric"
    },
    {
      "time": 100.644,
      "text": "海風吹著你的歌聲",
      "kind": "lyric"
    },
    {
      "time": 104.691,
      "text": "吹著你的頭髮",
      "kind": "lyric"
    },
    {
      "time": 107.491,
      "text": "就算眼前路要面對長長孤單",
      "kind": "lyric"
    },
    {
      "time": 111.992,
      "text": "心有一點點累",
      "kind": "lyric"
    },
    {
      "time": 115.81,
      "text": "海風吹著你的背影",
      "kind": "lyric"
    },
    {
      "time": 119.844,
      "text": "吹著你的願望",
      "kind": "lyric"
    },
    {
      "time": 122.699,
      "text": "你說你相信總會有那一天",
      "kind": "lyric"
    },
    {
      "time": 126.841,
      "text": "會實現 當初的誓言",
      "kind": "lyric"
    },
    {
      "time": 133.041,
      "text": "不用怕 我們慢慢的走",
      "kind": "lyric"
    },
