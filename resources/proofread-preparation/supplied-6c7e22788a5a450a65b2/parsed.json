{
  "blocks": [
    {
      "id": "line-1",
      "text": "每工早起的時陣",
      "spelling": "mué-kang tsá-khí ê sî-tsūn",
      "source_lines": [
        1,
        2
      ]
    },
    {
      "id": "line-4",
      "text": "若來看著你的朋友啊",
      "spelling": "ná lâi khuànn-tio̍h lí ê pîng-iú ah",
      "source_lines": [
        4,
        5
      ]
    },
    {
      "id": "line-7",
      "text": "敢會輕鬆寡",
      "spelling": "kám-ē khin-sang kuá",
      "source_lines": [
        7,
        8
      ]
    },
    {
      "id": "line-10",
      "text": "是按怎我的生活齷齪",
      "spelling": "sī án-tsuánn guá ê sing-ua̍h ok-tshok",
      "source_lines": [
        10,
        11
      ]
    },
    {
      "id": "line-13",
      "text": "心情不時沉重",
      "spelling": "sim-tsîng put-sî tîm-tāng",
      "source_lines": [
        13,
        14
      ]
    },
    {
      "id": "line-16",
      "text": "嘛不願共你講",
      "spelling": "mā m̄-guān kā lí kóng",
      "source_lines": [
        16,
        17
      ]
    },
    {
      "id": "line-19",
      "text": "轉去過去的海岸",
      "spelling": "tńg-khì kuè-khì ê hái-huānn",
      "source_lines": [
        19,
        20
      ]
    },
    {
      "id": "line-22",
      "text": "才知影都市的生活咱是袂扭掠",
      "spelling": "tsiah tsai-iánn too-tshī ê sing-ua̍h lán sī bē liú-lia̍h",
      "source_lines": [
        22,
        23
      ]
    },
    {
      "id": "line-25",
      "text": "是我青春幼稚痟眠夢",
      "spelling": "sī guá tshing-tshun iù-tī siáu bîn-bāng",
      "source_lines": [
        25,
        26
      ]
    },
    {
      "id": "line-28",
      "text": "大聲喝朋友啊",
      "spelling": "tuā-siann huah pîng-iú ah",
      "source_lines": [
        28,
        29
      ]
    },
    {
      "id": "line-31",
      "text": "咱著輕鬆活啊",
      "spelling": "lán tio̍h khin-sang ua̍h ah",
      "source_lines": [
        31,
        32
      ]
    }
  ],
  "credits": [],
  "notes": [],
  "reasons": []
}
