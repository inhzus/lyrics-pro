{
  "blocks": [
    {
      "id": "line-1",
      "text": "葉 落入窗外 霧雺雺",
      "spelling": "hio̍h lo̍h-li̍p thang-guā bū bông bông",
      "source_lines": [
        1,
        2
      ]
    },
    {
      "id": "line-4",
      "text": "春日遲遲 雨綿綿",
      "spelling": "tshun-li̍t tî tî hōo mî mî",
      "source_lines": [
        4,
        5
      ]
    },
    {
      "id": "line-7",
      "text": "妳 站在窗邊 睨睨看",
      "spelling": "lí khiā tī thang pinn gîn gîn khuànn",
      "source_lines": [
        7,
        8
      ]
    },
    {
      "id": "line-10",
      "text": "雨過天青 虹彩晝",
      "spelling": "hōo kuè thian tshing khīng tshái tàu",
      "source_lines": [
        10,
        11
      ]
    },
    {
      "id": "line-13",
      "text": "花 開在心房 茂離離",
      "spelling": "hue khui teh sim-pâng ōm lī-lī",
      "source_lines": [
        13,
        14
      ]
    },
    {
      "id": "line-16",
      "text": "昨日寒冰 融春水",
      "spelling": "tsa-li̍t hân ping iông tshun tsuí",
      "source_lines": [
        16,
        17
      ]
    },
    {
      "id": "line-19",
      "text": "妳 打開心門 髻頭鬃",
      "spelling": "lí phah-khui sim mn̂g kuè thâu-tsang",
      "source_lines": [
        19,
        20
      ]
    },
    {
      "id": "line-22",
      "text": "蛹破蝶飛 種種去",
      "spelling": "ióng phuà ia̍h pue tsióng-tsióng khì",
      "source_lines": [
        22,
        23
      ]
    },
    {
      "id": "line-25",
      "text": "手牽妳 人相偎",
      "spelling": "tshiú-khan lí lâng siong uá",
      "source_lines": [
        25,
        26
      ]
    },
    {
      "id": "line-28",
      "text": "舞步過 萬花叢",
      "spelling": "bú-pōo kuè bān-hue tsâng",
      "source_lines": [
        28,
        29
      ]
    },
    {
      "id": "line-31",
      "text": "飛入情 愛酸澀",
      "spelling": "pue li̍p tsîng ài sng siap",
      "source_lines": [
        31,
        32
      ]
    },
    {
      "id": "line-34",
      "text": "甘苦命 無牽掛",
      "spelling": "kam-khóo miā bô sia̍p-kuà",
      "source_lines": [
        34,
        35
      ]
    },
    {
      "id": "line-37",
      "text": "貪戀之間 袂記得痛",
      "spelling": "tham-luân tsi-kan buē-kì-tit thiànn",
      "source_lines": [
        37,
        38
      ]
    },
    {
      "id": "line-40",
      "text": "一瞬光景 甘要永遠",
      "spelling": "tsi̍t sut kng-kíng kam beh íng-uán",
      "source_lines": [
        40,
        41
      ]
    },
    {
      "id": "line-43",
      "text": "艷衫化作 蝴蝶",
      "spelling": "kiam sam huà-tsuè ôo-tia̍p",
      "source_lines": [
        43,
        44
      ]
    }
  ],
  "credits": [],
  "notes": [],
  "reasons": []
}
