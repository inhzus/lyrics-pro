{
  "recording_id": "netease:490182969",
  "source": "User-supplied resources/lyrics-spelling/一個人-Ripple",
  "blocks": [
    {
      "id": "line-3",
      "text": "半開的窗 窗外的光",
      "spelling": "puànn khui ê thang thang-guā ê kng",
      "source_lines": [
        3,
        4
      ]
    },
    {
      "id": "line-6",
      "text": "月娘啊妳敢有聽著我的聲",
      "spelling": "gue̍h-niû ah lí kám-ū thiann-tio̍h guá ê siann",
      "source_lines": [
        6,
        7
      ]
    },
    {
      "id": "line-9",
      "text": "長長的路 冷冷的風",
      "spelling": "tn̂g tn̂g ê lōo líng líng ê hong",
      "source_lines": [
        9,
        10
      ]
    },
    {
      "id": "line-12",
      "text": "但是現在只剩我家己咧行",
      "spelling": "tān-sī tsit-má tsí tshun guá ka-kī leh kiânn",
      "source_lines": [
        12,
        13
      ]
    },
    {
      "id": "line-15",
      "text": "那行那唱歌嘛無人聽",
      "spelling": "ná kiânn ná tshiùnn-kua mā bô-lâng thiann",
      "source_lines": [
        15,
        16
      ]
    },
    {
      "id": "line-18",
      "text": "想起妳的時陣我驚惶",
      "spelling": "siūnn-khí lí ê sî-tsūn guá kiann-hiânn",
      "source_lines": [
        18,
        19
      ]
    },
    {
      "id": "line-21",
      "text": "目屎欲流煞哭袂出聲",
      "spelling": "ba̍k-sái bē lâu suah khàu buē tshut-siann",
      "source_lines": [
        21,
        22
      ]
    },
    {
      "id": "line-24",
      "text": "妳佇佗位有誰會知影",
      "spelling": "lí tī tó-uī ū siáng ē tsai-iánn",
      "source_lines": [
        24,
        25
      ]
    },
    {
      "id": "line-27",
      "text": "放我一個人佇遮創啥",
      "spelling": "pàng guá tsi̍t ê lâng tī tsiâ tshòng siánn",
      "source_lines": [
        27,
        28
      ]
    },
    {
      "id": "line-30",
      "text": "妳叫我欲按怎",
      "spelling": "lí kiò guá bē án-tsuánn",
      "source_lines": [
        30,
        31
      ]
    },
    {
      "id": "line-33",
      "text": "留我一個人妳甘快活",
      "spelling": "lâu guá tsi̍t ê lâng lí kam khuìnn-ua̍h",
      "source_lines": [
        33,
        34
      ]
    },
    {
      "id": "line-36",
      "text": "看無妳的形影",
      "spelling": "khuànn bô lí ê hîng-iánn",
      "source_lines": [
        36,
        37
      ]
    },
    {
      "id": "line-39",
      "text": "予我一個人咧起畏寒",
      "spelling": "hōo guá tsi̍t ê lâng leh khí uì-kuânn",
      "source_lines": [
        39,
        40
      ]
    },
    {
      "id": "line-42",
      "text": "妳敢知影我的孤單",
      "spelling": "lí kám tsai-iánn guá ê koo-tuann",
      "source_lines": [
        42,
        43
      ]
    },
    {
      "id": "line-45",
      "text": "欲叫妳名煞喊袂出聲",
      "spelling": "bē kiò lí miâ suah uah buē tshut-siann",
      "source_lines": [
        45,
        46
      ]
    },
    {
      "id": "line-48",
      "text": "其實攏無較縒",
      "spelling": "kî-si̍t lóng bô khah tsua̍h",
      "source_lines": [
        48,
        49
      ]
    },
    {
      "id": "line-51",
      "text": "予上心愛的妳啊",
      "spelling": "guá siōng sim-ài ê lí ah",
      "source_lines": [
        51,
        52
      ]
    },
    {
      "id": "line-54",
      "text": "我敢會當擱有期待",
      "spelling": "guá kám ē-tàng koh ū kî-thāi",
      "source_lines": [
        54,
        55
      ]
    },
    {
      "id": "line-57",
      "text": "攏無躊躇的離開",
      "spelling": "lóng bô tiû-tû ê lī-khui",
      "source_lines": [
        57,
        58
      ]
    },
    {
      "id": "line-60",
      "text": "我猶是袂通瞭解",
      "spelling": "guá iáu sī buē-thàng liáu-kái",
      "source_lines": [
        60,
        61
      ]
    },
    {
      "id": "line-63",
      "text": "彼日的咱講啥",
      "spelling": "hit li̍t ê lán kóng siánn",
      "source_lines": [
        63,
        64
      ]
    },
    {
      "id": "line-66",
      "text": "我猶原會囥佇心肝底",
      "spelling": "guá iu-guân ē khǹg tī sim-kuann té",
      "source_lines": [
        66,
        67
      ]
    },
    {
      "id": "line-69",
      "text": "講不出口的彼句話",
      "spelling": "kóng buē-tshut-tshuì ê hit kù-uē",
      "source_lines": [
        69,
        70
      ]
    },
    {
      "id": "line-72",
      "text": "已經無力通去解釋",
      "spelling": "í-king bô-la̍t thàng khì kái-sik",
      "source_lines": [
        72,
        73
      ]
    },
    {
      "id": "line-75",
      "text": "放我一個人佇遮創啥",
      "spelling": "pàng guá tsi̍t ê lâng tī tsiâ tshòng siánn",
      "source_lines": [
        75,
