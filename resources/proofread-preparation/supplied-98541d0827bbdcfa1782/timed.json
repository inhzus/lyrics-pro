    },
    {
      "time": 100.29,
      "text": "透早日头照入彼扇窗",
      "kind": "lyric"
    },
    {
      "time": 103.64,
      "text": "怎样过画只剩一片壁",
      "kind": "lyric"
    },
    {
      "time": 107.11,
      "text": "天甘有在看",
      "kind": "lyric"
    },
    {
      "time": 108.98,
      "text": "为着啥阮的命由在人来拆",
      "kind": "lyric"
    },
    {
      "time": 115.02,
      "text": "一口鼎 一领衫 一块瓦",
      "kind": "lyric"
    },
    {
      "time": 117.86,
      "text": "缀惊惶拢埋入土脚",
      "kind": "lyric"
    },
    {
      "time": 122.02,
      "text": "一个人 一家人 一世人",
      "kind": "lyric"
    },
    {
