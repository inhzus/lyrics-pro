{
  "recording_id": "lrcapi:1445521667",
  "source": "LrcAPI https://api.lrc.cx/jsonapi?title=%E6%8E%A2%E6%88%88%E6%8E%A2%E6%88%88&artist=%E6%B1%9F%E8%95%99&album=%E5%BD%93%E6%97%B6%E6%AC%B2%E5%AB%81#1445521667",
  "lines": [
    {
      "time": 23.68,
      "text": "你甘知这是什麼警报",
      "kind": "lyric"
    },
    {
      "time": 26.44,
      "text": "哪会害彼多人心狂火著",
      "kind": "lyric"
    },
    {
      "time": 30.99,
      "text": "是一段上美妙的探戈",
      "kind": "lyric"
    },
    {
      "time": 34.13,
      "text": "探戈 咱拢袂生疏",
      "kind": "lyric"
    },
    {
      "time": 37.84,
      "text": "情爱是每个人上惊的功课",
      "kind": "lyric"
    },
    {
      "time": 42.08,
      "text": "所以才需要双人做阵来学",
      "kind": "lyric"
    },
    {
      "time": 46.25,
      "text": "两个人会当斗阵必有缘",
      "kind": "lyric"
    },
    {
      "time": 49.33,
      "text": "故 卡紧向大家宣布",
      "kind": "lyric"
    },
    {
      "time": 53.93,
      "text": "啊～探戈 虽然是有时点",
      "kind": "lyric"
    },
    {
      "time": 58.88,
      "text": "头 有时摇头 无奈何",
      "kind": "lyric"
    },
    {
      "time": 61.55,
      "text": "啊～探戈 爱就是",
      "kind": "lyric"
    },
    {
      "time": 65.55,
      "text": "互相痛疼 互相爱慕",
      "kind": "lyric"
    },
    {
      "time": 84.97,
      "text": "你甘知这是什麼信号",
      "kind": "lyric"
    },
    {
      "time": 88.02,
      "text": "哪会害彼多人嘴笑目笑",
      "kind": "lyric"
    },
    {
      "time": 92.31,
      "text": "像一段上奥妙的探戈",
      "kind": "lyric"
    },
    {
      "time": 95.61,
      "text": "探戈 甜蜜的招呼",
      "kind": "lyric"
    },
    {
      "time": 99.64,
      "text": "情爱是两个人上水的错误",
      "kind": "lyric"
    },
    {
      "time": 104.16,
      "text": "千万种考验才来变成钻石",
      "kind": "lyric"
    },
    {
      "time": 107.52,
      "text": "期待咱行过过去彼段风",
      "kind": "lyric"
    },
    {
      "time": 111.02,
      "text": "雨 换来是一种骄傲",
      "kind": "lyric"
    },
    {
      "time": 115.43,
      "text": "啊～探戈 两个人有时前",
      "kind": "lyric"
    },
    {
      "time": 135.61,
      "text": "进 有时退后 相让步",
      "kind": "lyric"
    },
    {
      "time": 138.57,
      "text": "啊～探戈 爱需要",
      "kind": "lyric"
    },
    {
      "time": 142.72,
      "text": "互相体贴 互相照顾",
      "kind": "lyric"
    }
  ]
}
