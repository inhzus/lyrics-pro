{
  "blocks": [
    {
      "id": "line-3",
      "text": "(女)愛 好親像過客",
      "spelling": "ài  hònn tshin-tshiūnn kuè-kheh",
      "source_lines": [
        3,
        4
      ]
    },
    {
      "id": "line-6",
      "text": "(男)情 好親像冬雪",
      "spelling": "tsîng  hònn tshin-tshiūnn tang seh",
      "source_lines": [
        6,
        7
      ]
    },
    {
      "id": "line-9",
      "text": "(女)一場風雨的經過 將你咱綁作伙",
      "spelling": "tsi̍t-tiûnn hong-hōo ê king-kuè  tsiòng lí lán pa̍k tsò-hué",
      "source_lines": [
        9,
        10
      ]
    },
    {
      "id": "line-12",
      "text": "(男)無論風塊吹 雲塊飛 情愛像梅花",
      "spelling": "bô-lūn hong tè tshue  hûn tè pue  tsîng-ài tshiūnn muî-hue",
      "source_lines": [
        12,
        13
      ]
    },
    {
      "id": "line-15",
      "text": "(男)天愈冷",
      "spelling": "thinn lú líng",
      "source_lines": [
        15,
        16
      ]
    },
    {
      "id": "line-18",
      "text": "(女)心愈撐",
      "spelling": "sim lú kīng",
      "source_lines": [
        18,
        19
      ]
    },
    {
      "id": "line-21",
      "text": "(合)感情愈堅定",
      "spelling": "kám-tsîng lú kian-tīng",
      "source_lines": [
        21,
        22
      ]
    },
    {
      "id": "line-24",
      "text": "(男)愛可比雪中花",
      "spelling": "ài khó-pí suat tiong hue",
      "source_lines": [
        24,
        25
      ]
    },
    {
      "id": "line-27",
      "text": "(女)若是打袂開心內的謎題",
      "spelling": "ná sī phah buē khui sim-lāi ê bê tê",
      "source_lines": [
        27,
        28
      ]
    },
    {
      "id": "line-30",
      "text": "(合)情愛真真假假 有魂無體",
      "spelling": "tsîng-ài tsin-tsin-ké-ké  ū hûn bô thé",
      "source_lines": [
        30,
        31
      ]
    },
    {
      "id": "line-33",
      "text": "(女)雪嘛嘸講話",
      "spelling": "seh mah m̄ kóng-uē",
      "source_lines": [
        33,
        34
      ]
    },
    {
      "id": "line-36",
      "text": "(男)花嘛無聲無說",
      "spelling": "hue mah bô siann bô suè",
      "source_lines": [
        36,
        37
