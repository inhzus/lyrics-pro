      "source_lines": [
        15,
        16
      ]
    },
    {
      "id": "line-18",
      "text": "無表情誒臉 無感情欸路",
      "spelling": "bô piáu-tsîng ê bīn bô kám-tsîng ê lōo",
      "source_lines": [
        18,
        19
      ]
    },
    {
      "id": "line-21",
      "text": "這是社會 要你的模樣啊",
