{
  "blocks": [
    {
      "id": "line-3",
      "text": "嘸管天地有多闊",
      "spelling": "m̄-kuán thinn-tē ū lōa khuah",
      "source_lines": [
        3,
        4
      ]
    },
    {
      "id": "line-6",
      "text": "嘸管路有多歹行",
      "spelling": "m̄-kuán lōo ū lōa pháinn-kiânn",
      "source_lines": [
        6,
        7
      ]
    },
    {
      "id": "line-9",
      "text": "若講我有時會孤單",
      "spelling": "ná kóng guá ū-sî ē koo-tuann",
      "source_lines": [
        9,
        10
      ]
    },
    {
      "id": "line-12",
      "text": "也有你來作伴",
      "spelling": "mā ū lí lâi tsuè-phuānn",
      "source_lines": [
        12,
        13
      ]
    },
    {
      "id": "line-15",
      "text": "心也是全然唔驚",
      "spelling": "sim iā-sī tsuân-liân m̄-kiann",
      "source_lines": [
        15,
        16
      ]
    },
    {
      "id": "line-18",
      "text": "我上大聲",
      "spelling": "guá siōng tuā-siann",
      "source_lines": [
        18,
        19
      ]
    },
    {
      "id": "line-21",
      "text": "威風踏四門 踏出神勇的腳步",
      "spelling": "ui-hong ta̍h sù mn̂g ta̍h tshut-sîn ióng ê kha-pōo",
      "source_lines": [
        21,
        22
      ]
    },
    {
      "id": "line-24",
      "text": "無驚風雨向前走 步罡踏斗展正氣",
      "spelling": "m̄-kiann hong-hōo hiòng-tsiân kiânn pōo kong ta̍h-táu tián tsiànn-khuì",
      "source_lines": [
        24,
        25
      ]
    },
    {
      "id": "line-27",
      "text": "春風少年時 有咱傷心放蕩過去",
      "spelling": "tshun-hong siàu-liân sî ū lán siong-sim hòng-tōng kuè-khì",
      "source_lines": [
        27,
        28
      ]
    },
    {
      "id": "line-30",
      "text": "風雨吹散是虛情甲假意 咱用心交陪是真正兄弟",
      "spelling": "hong-hōo tshue suánn sī hi-tsîng kah ké-ì lán iōng-sim kau-puê sī tsin-tsiànn hiann-tī",
      "source_lines": [
        30,
        31
      ]
    },
    {
      "id": "line-33",
      "text": "我嘸管風雨有多大",
      "spelling": "guá m̄-kuán hong-hōo ū juā-tuā",
      "source_lines": [
        33,
        34
      ]
    },
    {
      "id": "line-36",
      "text": "有我陪你作陣走",
      "spelling": "ū guá puê lí tsuè tīn kiânn",
      "source_lines": [
        36,
        37
      ]
    },
    {
      "id": "line-39",
      "text": "若講我有時會孤單",
      "spelling": "ná kóng guá ū-sî ē koo-tuann",
      "source_lines": [
