  "lines": [
    {
      "time": 0.713,
      "text": "我看著那年的電影‭ ‬演阿演‭ ‬",
      "kind": "lyric"
    },
    {
      "time": 5.066,
      "text": "每一段只有影卻沒聲",
      "kind": "lyric"
    },
    {
      "time": 9.265,
      "text": "身軀它提醒著我 那時的燒熱",
      "kind": "lyric"
    },
    {
      "time": 18.019,
      "text": "我看著那年的電影‭ ‬搬阿搬",
      "kind": "lyric"
    },
    {
      "time": 22.151,
      "text": "每一段只有心內它知道",
      "kind": "lyric"
    },
    {
      "time": 26.464,
      "text": "屬於我們的歌 會永遠留在我的心肝‭ ‬",
      "kind": "lyric"
    },
    {
      "time": 36.318,
      "text": "半眠兩點多‭ ‬想起之前的生活",
      "kind": "lyric"
    },
    {
      "time": 43.613,
      "text": "經過了這多年‭ ‬最懷念‭依然是那段",
      "kind": "lyric"
    },
    {
      "time": 52.111,
      "text": "我們在頂樓玩耍‭ ‬有月娘偷偷的看",
      "kind": "lyric"
    },
    {
      "time": 61.01,
      "text": "也有街坊鄰居跑過來罵",
      "kind": "lyric"
    },
    {
      "time": 70.565,
      "text": "什麼都不怕的年輕人 現在是跑去哪",
      "kind": "lyric"
    },
    {
      "time": 79.268,
      "text": "心內那麼簡單的快樂 現在在哪裡啊",
      "kind": "lyric"
