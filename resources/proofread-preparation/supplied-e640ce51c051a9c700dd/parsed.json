{
  "blocks": [
    {
      "id": "line-1",
      "text": "手端杯子 深望",
      "spelling": "tshiú tuann pue-á tshim bāng",
      "source_lines": [
        1,
        2
      ]
    },
    {
      "id": "line-4",
      "text": "茶盤圓圓 甜茶甜甜",
      "spelling": "tê-puânn înn-înn tinn-tê tinn-tinn",
      "source_lines": [
        4,
        5
      ]
    },
    {
      "id": "line-7",
      "text": "是怎樣的路 是怎樣的夢",
      "spelling": "sī tsuánn-iūnn ê lōo sī tsuánn-iūnn ê bāng",
      "source_lines": [
        7,
        8
      ]
    },
    {
      "id": "line-10",
      "text": "兩人相依 走到這段",
      "spelling": "nn̄g-lâng siong-uá kiânn-kàu tsit tuānn",
      "source_lines": [
        10,
        11
      ]
    },
    {
      "id": "line-13",
      "text": "新郎新娘 面紅",
      "spelling": "sin-lông sin-niû bīn-âng",
      "source_lines": [
        13,
        14
      ]
    },
    {
      "id": "line-16",
      "text": "茶盤金金 茶甌深深",
      "spelling": "tê-puânn kim kim tê-au tshim-tshim",
      "source_lines": [
        16,
        17
      ]
    },
    {
      "id": "line-19",
      "text": "是怎樣感覺 是怎樣放下",
      "spelling": "sī tsuánn-iūnn kám-kak sī tsuánn-iūnn hòng-hā",
      "source_lines": [
        19,
        20
      ]
    },
    {
      "id": "line-22",
      "text": "餵養幾冬 如今嫁人",
      "spelling": "tshīa iáng kuí tang lû-kim kè-lâng",
      "source_lines": [
        22,
        23
      ]
    },
    {
      "id": "line-25",
      "text": "嫁出的女兒 水外潑",
      "spelling": "kè tshut ê tsa-kiánn tsuí guā phuah",
      "source_lines": [
        25,
        26
      ]
    },
    {
      "id": "line-28",
      "text": "望妳幸福 不再牽掛",
      "spelling": "bāng lí hīng-hok buē-koh khian-kuà",
      "source_lines": [
        28,
        29
      ]
    },
    {
      "id": "line-31",
      "text": "看你的背影 目屎吞下",
      "spelling": "khuànn lí ê puē-iánn ba̍k-sái thun-hā",
      "source_lines": [
        31,
        32
      ]
    },
    {
      "id": "line-34",
      "text": "笑容是阮 最深願望",
      "spelling": "tshiò-iông sī gún siōng tshim guān-bāng",
      "source_lines": [
        34,
        35
      ]
    },
    {
