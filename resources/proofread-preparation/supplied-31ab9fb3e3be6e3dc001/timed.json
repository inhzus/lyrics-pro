    {
      "time": 1.0,
      "text": "作曲 : 萧煌奇",
      "kind": "credit"
    },
    {
      "time": 18.71,
      "text": "敢会当莫来问 我的过去",
      "kind": "lyric"
    },
    {
      "time": 21.95,
      "text": "过去的无聊的梦 无记忆",
      "kind": "lyric"
    },
    {
      "time": 27.05,
      "text": "啉一杯无糖咖啡 我敬汝",
      "kind": "lyric"
    },
    {
      "time": 30.41,
      "text": "爱情 随侬 滋味",
      "kind": "lyric"
    },
    {
      "time": 35.82,
      "text": "上惊是三更半暝睏袂去",
      "kind": "lyric"
    },
    {
      "time": 39.35,
      "text": "绵绵的旧情 犹原浮伫眼前",
      "kind": "lyric"
    },
    {
      "time": 44.06,
      "text": "汝踮我的身边 窗外雨水声音是空",
      "kind": "lyric"
    },
    {
      "time": 52.13,
      "text": "爱过的侬 斟酌听",
      "kind": "lyric"
    },
    {
      "time": 55.77,
      "text": "孤单是多情侬 心内的疼",
      "kind": "lyric"
    },
    {
      "time": 60.8,
      "text": "原谅我也毋敢望",
      "kind": "lyric"
    },
    {
      "time": 64.42,
      "text": "明明汝爱我 将汝当做是过路的侬",
      "kind": "lyric"
    },
    {
      "time": 70.83,
      "text": "汝爱的侬 伊毋是无情侬",
      "kind": "lyric"
    },
    {
      "time": 74.24,
      "text": "伊只是毋敢行过 情路无尾巷",
      "kind": "lyric"
    },
    {
      "time": 78.69,
      "text": "感情予伊一侬 爱遘无酒也茫茫",
      "kind": "lyric"
    },
    {
      "time": 83.73,
      "text": "头前是乌暗 越头也无望",
      "kind": "lyric"
    },
    {
      "time": 88.46,
      "text": "汝爱的侬 看破做无情侬",
      "kind": "lyric"
    },
    {
      "time": 91.91,
      "text": "毋愿佫再来行过 情路无尾巷",
      "kind": "lyric"
    },
    {
      "time": 96.27,
      "text": "感情莫看遐重 有缘感谢汝陪伴",
      "kind": "lyric"
    },
    {
      "time": 101.18,
      "text": "幸福有来过 只是袂当到永远",
      "kind": "lyric"
