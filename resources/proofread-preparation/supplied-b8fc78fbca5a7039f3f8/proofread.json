    {
      "id": "line-1",
      "text": "做雞著愛筅    做人著愛反",
      "spelling": "tsò ke tio̍h ài tshíng  tsò lâng tio̍h ài píng",
      "source_lines": [
        1,
        2
      ],
      "parts": [
        {
          "text": "做雞著愛筅",
          "spelling": "tsò ke tio̍h ài tshíng"
        },
        {
          "text": "做人著愛反",
          "spelling": "tsò lâng tio̍h ài píng"
        }
      ]
    },
    {
      "id": "line-4",
      "text": "拍過難關  拍出熱情  拍出咱的前程",
      "spelling": "phah-kuè lân-kuan phah tshut lia̍t-tsîng  phah tshut lán ê tsiân-tîng",
      "source_lines": [
        4,
        5
      ]
    },
    {
      "id": "line-7",
      "text": "人  一世人  風景  無仝款",
      "spelling": "lâng  tsi̍t-sì-lâng  hong-kíng  bô kâng-khuán",
      "source_lines": [
        7,
        8
      ],
      "parts": [
        {
          "text": "人",
          "spelling": "lâng"
        },
        {
          "text": "一世人",
          "spelling": "tsi̍t-sì-lâng"
        },
        {
