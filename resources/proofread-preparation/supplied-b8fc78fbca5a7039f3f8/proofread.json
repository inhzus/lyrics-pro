        }
      ]
    },
    {
      "id": "line-10",
      "text": "春夏秋冬 一冬兩冬  愛做就愛動",
      "spelling": "tshun hā tshiu tang tsi̍t tang nn̄g tang  ài tsò tio̍h ài tāng",
      "source_lines": [
        10,
        11
      ],
      "parts": [
        {
          "text": "春夏秋冬 一冬兩冬",
          "spelling": "tshun hā tshiu tang tsi̍t tang nn̄g tang"
        },
        {
          "text": "愛做就愛動",
          "spelling": "ài tsò tio̍h ài tāng"
        }
      ]
    },
    {
