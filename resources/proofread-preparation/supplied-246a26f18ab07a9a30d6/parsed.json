{
  "blocks": [
    {
      "id": "line-1",
      "text": "懷念著彼個無緣的人",
      "spelling": "huâi-liām-tio̍h hit-ê bô-iân ê lâng",
      "source_lines": [
        1,
        2
      ]
    },
    {
      "id": "line-4",
      "text": "怎樣乎我的心頭亂",
      "spelling": "tsuánn-iūnn hoo guá sim-thâu luān",
      "source_lines": [
        4,
        5
      ]
    },
    {
      "id": "line-7",
      "text": "當初你那甭感情搏這重",
      "spelling": "tong-tshoo lí ná bàng kám-tsîng phok tsia tāng",
      "source_lines": [
        7,
        8
      ]
    },
    {
      "id": "line-10",
      "text": "今日也免為你塊怨嘆",
      "spelling": "kin-li̍t iā bián uî lí tè uàn-thàn",
      "source_lines": [
        10,
        11
      ]
    },
    {
      "id": "line-13",
      "text": "甘是我癡情過頭重",
      "spelling": "kam sī guá tshi-tsîng kuè-thâu tāng",
      "source_lines": [
        13,
        14
      ]
    },
    {
      "id": "line-16",
      "text": "也是你目頭有卡高",
      "spelling": "ia̍h-sī lí ba̍k-thâu ū khá kuân",
      "source_lines": [
        16,
        17
      ]
    },
    {
      "id": "line-19",
      "text": "想要將你放",
      "spelling": "siūnn-buē tsiòng lí pàng",
      "source_lines": [
        19,
        20
      ]
    },
    {
      "id": "line-22",
      "text": "想要將你放",
      "spelling": "siūnn-bē tsiòng lí pàng",
      "source_lines": [
        22,
        23
      ]
    },
    {
      "id": "line-25",
      "text": "心肝又不甘",
      "spelling": "sim-kuann iū m̄ kam",
      "source_lines": [
        25,
        26
      ]
    },
    {
      "id": "line-28",
      "text": "因為你是我最懷念的人",
      "spelling": "in-uī lí sī guá tsuè huâi-liām ê lâng",
      "source_lines": [
        28,
        29
      ]
    },
