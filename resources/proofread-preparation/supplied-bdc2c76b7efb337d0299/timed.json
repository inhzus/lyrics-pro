{
  "recording_id": "lrcapi:1753652884",
  "source": "LrcAPI https://api.lrc.cx/jsonapi?title=%E8%B2%B3%E4%BC%8D%E9%80%99%E5%86%AC&artist=%E6%8B%8D%E8%AC%9D%E5%B0%91%E5%B9%B4&album=%E6%B5%B7%E5%8F%A3%E5%91%B3#1753652884",
  "lines": [
    {
      "time": 33.61,
      "text": "佇這款無夢的日",
      "kind": "lyric"
    },
    {
      "time": 36.75,
      "text": "隨風搧動的人生",
      "kind": "lyric"
    },
    {
      "time": 40.34,
      "text": "是阮無夠打拼",
      "kind": "lyric"
    },
    {
      "time": 43.89,
      "text": "抑是無緣份",
      "kind": "lyric"
    },
    {
      "time": 46.91,
      "text": "一世人無暝無日",
      "kind": "lyric"
    },
    {
      "time": 50.12,
      "text": "為著賺食來浮沈",
      "kind": "lyric"
    },
    {
      "time": 53.93,
      "text": "怨嘆袂當改變",
      "kind": "lyric"
    },
    {
      "time": 57.04,
      "text": "阮飄泊的一生",
      "kind": "lyric"
    },
    {
      "time": 87.74,
      "text": "故鄉的夢 親情的心",
      "kind": "lyric"
    },
    {
      "time": 91.12,
      "text": "生份的人疼痛",
      "kind": "lyric"
    },
    {
      "time": 94.21,
      "text": "原諒阮愛眠夢",
      "kind": "lyric"
    },
    {
      "time": 96.28,
      "text": "見講一句：有我無別人",
      "kind": "lyric"
    },
    {
      "time": 100.98,
      "text": "你講自由的路",
      "kind": "lyric"
    },
    {
      "time": 102.86,
      "text": "毋通拖沙",
      "kind": "lyric"
    },
    {
      "time": 104.73,
      "text": "青春才是夢啊",
      "kind": "lyric"
    },
    {
      "time": 107.49,
      "text": "只有講著一句 喝著一句",
      "kind": "lyric"
    },
    {
      "time": 111.43,
      "text": "唉 唉 唉 唉",
      "kind": "lyric"
    },
    {
      "time": 135.04,
      "text": "思念的心",
      "kind": "lyric"
    },
    {
      "time": 140.06,
      "text": "這擺我攏敢擔",
      "kind": "lyric"
    },
    {
      "time": 145.36,
      "text": "自由佇眠夢",
      "kind": "lyric"
    },
    {
      "time": 150.13,
      "text": "夢中我佇佗位啊",
      "kind": "lyric"
    },
    {
      "time": 155.37,
      "text": "堅強的男兒",
      "kind": "lyric"
    },
    {
      "time": 160.4,
      "text": "孤單的烏暗暝",
      "kind": "lyric"
    },
    {
      "time": 165.45,
      "text": "溫柔的男兒",
      "kind": "lyric"
    },
    {
      "time": 170.48,
      "text": "毋驚風雨去",
      "kind": "lyric"
    }
  ]
}
