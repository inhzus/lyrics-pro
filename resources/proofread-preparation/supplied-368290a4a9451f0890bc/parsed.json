{
  "blocks": [
    {
      "id": "line-1",
      "text": "一個人 想全天 一個人 睏全天",
      "spelling": "tsi̍t ê lâng siūnn kui-kang tsi̍t ê lâng khùn kui-kang",
      "source_lines": [
        1,
        2
      ]
    },
    {
      "id": "line-4",
      "text": "一個人 哎喲 沒嫁翁",
      "spelling": "tsi̍t ê lâng ai-iō bô kè-ang",
      "source_lines": [
        4,
        5
      ]
    },
    {
      "id": "line-7",
      "text": "在這個 社會中 無論你 多堅強",
      "spelling": "tī tsit-ê siā-huē-tiong bô-lūn lí guā kian-kiông",
      "source_lines": [
        7,
        8
      ]
    },
    {
      "id": "line-10",
      "text": "一個人 哎喲 沒路用",
      "spelling": "tsi̍t ê lâng ai-iō bô-lōo-iōng",
      "source_lines": [
        10,
        11
      ]
    },
    {
      "id": "line-13",
      "text": "你問我袂安怎",
      "spelling": "lí mn̄g guá bē an-tsuánn",
      "source_lines": [
        13,
        14
      ]
    },
    {
      "id": "line-16",
      "text": "其實我不知影",
      "spelling": "kî-si̍t guá m̄ tsai-iánn",
      "source_lines": [
        16,
        17
      ]
    },
    {
      "id": "line-19",
      "text": "我也是羅漢跤",
      "spelling": "guá mā-sī lô-hàn kha",
      "source_lines": [
        19,
        20
      ]
    },
    {
      "id": "line-22",
      "text": "孤孤單單 嗚嗚暗暗",
      "spelling": "koo-koo-tuann-tuann oo oo àm àm",
      "source_lines": [
        22,
        23
      ]
    },
    {
      "id": "line-25",
      "text": "是安怎 搥心肝",
      "spelling": "sī an-tsuánn tuî sim-kuann",
      "source_lines": [
        25,
        26
      ]
    },
    {
      "id": "line-28",
      "text": "我不知影 沒想袂活",
      "spelling": "guá m̄ tsai-iánn bô-siūnn bē ua̍h",
      "source_lines": [
        28,
        29
      ]
    },
    {
      "id": "line-31",
      "text": "孤孤單單 嗚嗚暗暗",
