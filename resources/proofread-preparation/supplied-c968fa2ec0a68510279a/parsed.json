{
  "blocks": [
    {
      "id": "line-1",
      "text": "將思念放置心肝底",
      "spelling": "tsiòng su-liām khǹg tì sim-kuann té",
      "source_lines": [
        1,
        2
      ]
    },
    {
      "id": "line-4",
      "text": "甲煩心當作塊懺悔",
      "spelling": "kā huân-sim tòng-tsuè tè tshàm-hué",
      "source_lines": [
        4,
        5
      ]
    },
    {
      "id": "line-7",
      "text": "浪子啊有苦難言",
      "spelling": "lōng-tsú ah iū khóo-lān giân",
      "source_lines": [
        7,
        8
      ]
    },
    {
      "id": "line-10",
      "text": "不敢返去賠罪",
      "spelling": "m̄ kánn tńg-khì puê-tsuē",
      "source_lines": [
        10,
        11
      ]
    },
    {
      "id": "line-13",
      "text": "故鄉親人也難過",
      "spelling": "kòo-hiong tshin-lâng iā lân-kuè",
      "source_lines": [
        13,
        14
      ]
    },
    {
      "id": "line-16",
      "text": "人生尚歹過十字路口空徘徊",
      "spelling": "lîn-sing siōng pháinn-kuè si̍p lī lōo-kháu khang pai-hue",
      "source_lines": [
        16,
        17
      ]
    },
    {
      "id": "line-19",
      "text": "心中委屈有夠多",
      "spelling": "sim-tiong uí-khut ū kàu tsuē",
      "source_lines": [
        19,
        20
      ]
    },
    {
      "id": "line-22",
      "text": "街頭巷尾 萬家燈火",
      "spelling": "kue-thâu hāng-bué bān ke ting-hué",
      "source_lines": [
        22,
        23
      ]
    },
    {
      "id": "line-25",
      "text": "浪子心自省後悔",
      "spelling": "lōng-tsú sim tsū síng hiō-hué",
      "source_lines": [
        25,
        26
      ]
    },
    {
      "id": "line-28",
      "text": "一通電話 聽見阿母親切的印話",
      "spelling": "tsi̍t-thong tiān-uē thiann-kinn a-bú tshin-tshiat ê ìn uē",
      "source_lines": [
        28,
        29
      ]
    },
    {
      "id": "line-31",
      "text": "回頭路 嘸通躊躇不回",
      "spelling": "huê-thâu lōo m̄-thàng tiû-ti bû-huê",
      "source_lines": [
        31,
        32
      ]
    },
