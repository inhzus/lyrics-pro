  "source": "User-supplied resources/lyrics-spelling/赤焰-Ripple",
  "blocks": [
    {
      "id": "line-3",
      "text": "烏佮白",
      "spelling": "oo ka̍h pe̍h",
      "source_lines": [
        3,
        4
      ]
    },
    {
      "id": "line-6",
      "text": "為啥人攏看無詳細",
      "spelling": "uî siánn-lâng lóng khuànn bô siông-sè",
      "source_lines": [
        6,
        7
      ]
    },
    {
      "id": "line-9",
      "text": "毋著的到底佗一個",
      "spelling": "m̄-tio̍h ê tàu-té tué tsi̍t ê",
      "source_lines": [
        9,
        10
      ]
    },
    {
      "id": "line-12",
      "text": "猶擱有啥人是鬥陣的 鬥陣的",
      "spelling": "iáu koh ū siánn-lâng sī tàu-tīn ê tàu-tīn ê",
      "source_lines": [
        12,
        13
      ]
    },
    {
      "id": "line-15",
      "text": "站佮坐",
      "spelling": "khiā ka̍h tsē",
      "source_lines": [
        15,
        16
      ]
    },
    {
      "id": "line-18",
      "text": "攏是阮家己選擇的",
      "spelling": "lóng sī gún ka-kī suán-ti̍k ê",
      "source_lines": [
        18,
        19
      ]
    },
    {
      "id": "line-21",
      "text": "一心堅定想欲衝頭一個",
      "spelling": "tsi̍t-sim kian-tīng siūnn-beh tshiong thâu tsi̍t ê",
      "source_lines": [
        21,
        22
      ]
    },
    {
      "id": "line-24",
      "text": "哎相信一切會無問題 無問題",
      "spelling": "aih siong-sìn it-tshè ē bô būn-tê bô būn-tê",
      "source_lines": [
        24,
        25
      ]
    },
    {
      "id": "line-27",
      "text": "走跳世間拚輸贏",
      "spelling": "tsáu thiàu sè-kan piànn su-iânn",
      "source_lines": [
        27,
        28
      ]
    },
    {
      "id": "line-30",
      "text": "為著成功 為著咱的名",
      "spelling": "uī-tio̍h sîng-kong uī-tio̍h lán ê miâ",
      "source_lines": [
        30,
        31
      ]
    },
    {
      "id": "line-33",
      "text": "才知日頭赤焱焱",
      "spelling": "tsiah tsai li̍t-thâu tshiah iānn-iānn",
      "source_lines": [
        33,
        34
      ]
    },
    {
      "id": "line-36",
      "text": "生活是隨人顧性命",
      "spelling": "sing-ua̍h sī suî-lâng kòo sìnn-miā",
      "source_lines": [
        36,
        37
      ]
    },
    {
      "id": "line-39",
      "text": "走跳世間拚輸贏",
      "spelling": "tsáu thiàu sè-kan piànn su-iânn",
      "source_lines": [
        39,
