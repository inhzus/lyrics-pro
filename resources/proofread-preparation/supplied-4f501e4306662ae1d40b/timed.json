  "lines": [
    {
      "time": 22.04,
      "text": "在細漢的時陣 阮阿嬤對我尚好",
      "kind": "lyric"
    },
    {
      "time": 27.3,
      "text": "甲尚好的東西攏會留乎我",
      "kind": "lyric"
    },
    {
      "time": 32.74,
      "text": "伊嘛定定帶我去幼稚園看人在七桃",
      "kind": "lyric"
    },
    {
      "time": 37.52,
      "text": "看人在辦公伙兒 看人在覓相找",
      "kind": "lyric"
    },
    {
      "time": 43.97,
      "text": "伊定定跟阮說 叫阮著要好好仔讀冊",
      "kind": "lyric"
    },
    {
      "time": 49.81,
      "text": "嘸通大漢像恁老爸仔彼呢啊狼狽哦",
      "kind": "lyric"
    },
    {
      "time": 54.93,
      "text": "在彼個時陣 阮攏聽攏嘸",
      "kind": "lyric"
    },
    {
      "time": 60.92,
      "text": "阿嬤 妳到底是在講什麼",
      "kind": "lyric"
    },
    {
      "time": 65.93,
      "text": "大漢了後 才知影阿嬤的話",
      "kind": "lyric"
    },
    {
      "time": 70.91,
      "text": "我會甲永遠永遠放塊心肝底",
      "kind": "lyric"
    },
    {
      "time": 77.34,
      "text": "想到一步一步的過去",
      "kind": "lyric"
    },
    {
      "time": 82.18,
      "text": "定定攏會乎人真難忘",
      "kind": "lyric"
    },
    {
      "time": 88.2,
      "text": "時間一分一秒塊過去",
      "kind": "lyric"
    },
    {
      "time": 92.88,
      "text": "在阮的心內定定攏會想到伊",
      "kind": "lyric"
    },
    {
      "time": 104.78,
      "text": "阿嬤妳今嘛在叨位",
      "kind": "lyric"
    },
    {
      "time": 109.95,
      "text": "阮在叫妳妳甘有聽到",
      "kind": "lyric"
    },
    {
      "time": 115.34,
      "text": "阮的認真甲阮的成功 妳甘有看到",
      "kind": "lyric"
    },
    {
      "time": 120.89,
      "text": "阮在叫妳 妳知影沒",
      "kind": "lyric"
    },
    {
      "time": 127.14,
      "text": "阿嬤妳今嘛過的好麼",
      "kind": "lyric"
    },
    {
      "time": 131.91,
      "text": "甘有人塊甲妳照顧",
      "kind": "lyric"
    },
    {
      "time": 137.39,
      "text": "希望後世人阮擱會凍來乎妳疼",
      "kind": "lyric"
    },
    {
      "time": 142.96,
      "text": "作妳永遠的孫仔",
      "kind": "lyric"
    },
    {
      "time": 150.02,
      "text": "擱叫妳一聲阿嬤",
      "kind": "lyric"
    },
    {
