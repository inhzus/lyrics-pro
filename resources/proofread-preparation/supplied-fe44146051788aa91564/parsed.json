{
  "blocks": [
    {
      "id": "line-1",
      "text": "我來唸歌囉 厚恁聽哩",
      "spelling": "guá lâi liām kua lô hōo lín thiann lih",
      "source_lines": [
        1,
        2
      ]
    },
    {
      "id": "line-4",
      "text": "嗯免撿錢啊 免著驚呀喂",
      "spelling": "m̄-bián khioh tsînn ah bián-tio̍h kiann iah ueh",
      "source_lines": [
        4,
        5
      ]
    },
    {
      "id": "line-7",
      "text": "啊講到台灣 甘那船一隻",
      "spelling": "ah kóng-tio̍h Tâi-uân kam ná tsûn tsi̍t tsiah",
      "source_lines": [
        7,
        8
      ]
    },
    {
      "id": "line-10",
      "text": "眾人的雙腳 攏站惦這",
      "spelling": "tsiòng-lâng ê siang-kha lóng khiā tiām tsia",
      "source_lines": [
        10,
        11
      ]
    },
    {
      "id": "line-13",
      "text": "勸恁賣分 你跟我",
      "spelling": "khǹg lín māi hun lí kā guá",
      "source_lines": [
        13,
        14
      ]
    },
    {
      "id": "line-16",
      "text": "互相鬥幫忙",
      "spelling": "hōo-siong tàu pang-bâng",
      "source_lines": [
        16,
        17
      ]
    },
    {
      "id": "line-19",
      "text": "過去的過去呀",
      "spelling": "kuè-khì ê kuè-khì ia",
      "source_lines": [
        19,
        20
      ]
    },
    {
      "id": "line-22",
      "text": "今嘛就緩今嘛",
      "spelling": "kim mā tio̍h uān kim mā",
      "source_lines": [
        22,
        23
      ]
    },
    {
      "id": "line-25",
      "text": "我來唸歌囉 甘有人欲聽",
      "spelling": "guá lâi liām kua lô kam ū lâng bē thiann",
      "source_lines": [
        25,
        26
      ]
    },
    {
      "id": "line-28",
      "text": "伊～",
      "spelling": "i～",
      "source_lines": [
        28,
        29
      ]
    }
  ],
