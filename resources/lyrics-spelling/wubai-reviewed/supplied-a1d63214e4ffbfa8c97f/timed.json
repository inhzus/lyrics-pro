      "text": "戏棚跤嘛 拢无人",
      "kind": "lyric"
    },
    {
      "time": 91.8,
      "text": "路遮大条 拢无人",
      "kind": "lyric"
    },
    {
      "time": 93.99,
      "text": "路灯跤嘛 拢无人",
      "kind": "lyric"
    },
    {
      "time": 96.69,
      "text": "剃头店嘛 拢无人",
      "kind": "lyric"
    },
    {
      "time": 99.46,
      "text": "大庙口嘛 拢无人",
      "kind": "lyric"
    },
    {
      "time": 102.9,
      "text": "日时就是 拢无人",
      "kind": "lyric"
    },
    {
      "time": 105.3,
      "text": "暗时也是 拢无人",
      "kind": "lyric"
    },
    {
      "time": 107.77,
      "text": "我的身边 拢无人",
      "kind": "lyric"
    },
    {
      "time": 110.54,
      "text": "按怎揣嘛 揣无人",
      "kind": "lyric"
    },
    {
      "time": 159.76,
      "text": "天顶的月娘七早八早浮伫悬悬的半天",
      "kind": "lyric"
    },
    {
      "time": 168.83,
