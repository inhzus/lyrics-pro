---
---
<div class="controls" role="toolbar" aria-label="閱讀設定 Reading settings">
  <button type="button" data-action="romanization" aria-pressed="true" title="顯示台羅拼音 Show Tâi-lô">拼音</button>
  <span class="group" role="group" aria-label="字體大小 Text size">
    <button type="button" data-action="smaller" aria-label="縮小字體 Smaller text">A−</button>
    <button type="button" data-action="larger" aria-label="放大字體 Larger text">A+</button>
  </span>
  <button type="button" data-action="theme" aria-label="Theme">自動</button>
</div>

<style>
  .controls {
    position: sticky;
    top: 0.75rem;
    z-index: 1;
    display: none;
    width: fit-content;
    margin: 1.75rem 0 0;
    padding: 0.3rem;
    gap: 0.25rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  :global(.js) .controls { display: flex; }
  .group { display: flex; gap: 0.25rem; }
  button {
    min-width: 2.5rem;
    padding: 0.3rem 0.8rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }
  button:hover { color: var(--ink); background: var(--paper); }
  button[aria-pressed="true"] { color: var(--accent); }
  button:disabled { opacity: 0.35; cursor: default; }
</style>

<script>
  const root = document.documentElement;
  const THEMES = ["auto", "light", "dark"] as const;
  const THEME_LABELS = { auto: "自動", light: "淺色", dark: "深色" };
  const THEME_NAMES = { auto: "Theme: automatic", light: "Theme: light", dark: "Theme: dark" };

  function save(key: string, value: string | null) {
    try {
      if (value === null) localStorage.removeItem(key);
      else localStorage.setItem(key, value);
    } catch {}
  }

  for (const bar of document.querySelectorAll<HTMLElement>(".controls")) {
    const button = (action: string) => bar.querySelector<HTMLButtonElement>(`[data-action="${action}"]`)!;
    const romanization = button("romanization");
    const smaller = button("smaller");
    const larger = button("larger");
    const theme = button("theme");

    const render = () => {
      const size = Number(root.dataset.size ?? 2);
      romanization.setAttribute("aria-pressed", String(root.dataset.romanization !== "off"));
      smaller.disabled = size <= 0;
      larger.disabled = size >= 4;
      const current = (root.dataset.theme ?? "auto") as (typeof THEMES)[number];
      theme.textContent = THEME_LABELS[current];
      theme.setAttribute("aria-label", THEME_NAMES[current]);
      theme.title = THEME_NAMES[current];
    };

    romanization.addEventListener("click", () => {
      const off = root.dataset.romanization !== "off";
      if (off) root.dataset.romanization = "off";
      else delete root.dataset.romanization;
      save("romanization", off ? "off" : null);
      render();
    });
    const resize = (step: number) => {
      const size = Math.min(4, Math.max(0, Number(root.dataset.size ?? 2) + step));
      if (size === 2) delete root.dataset.size;
      else root.dataset.size = String(size);
      save("size", size === 2 ? null : String(size));
      render();
    };
    smaller.addEventListener("click", () => resize(-1));
    larger.addEventListener("click", () => resize(1));
    theme.addEventListener("click", () => {
      const current = (root.dataset.theme ?? "auto") as (typeof THEMES)[number];
      const next = THEMES[(THEMES.indexOf(current) + 1) % THEMES.length];
      if (next === "auto") delete root.dataset.theme;
      else root.dataset.theme = next;
      save("theme", next === "auto" ? null : next);
      render();
    });
    render();
  }
</script>
