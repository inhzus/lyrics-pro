---
import { artistSlug, type Song } from "../lib/catalog";
import PinButton from "./PinButton.astro";

interface Props {
  letters: [string, [string, Song[]][]][];
  /** The default pins, rendered in place so the first view matches most visitors' pins. */
  pinned: [string, Song[]][];
}
const { letters, pinned } = Astro.props;
const href = (artist: string) => `/artists/${artistSlug(artist)}/`;
const anchor = (letter: string) => (letter === "#" ? "other" : letter);
---
<label class="search">
  <span class="visually-hidden">搜尋歌名或歌手</span>
  <input id="filter" type="search" placeholder="搜尋歌名或歌手" autocomplete="off" />
</label>

<section id="pinned" class="letter pinned" aria-labelledby="pinned-title" hidden={pinned.length === 0}>
  <h2 id="pinned-title">置頂</h2>
  <ul class="artists">
    {pinned.map(([artist, list]) => (
      <li class="pinnable" data-path={href(artist)}>
        <a class="artist" href={href(artist)}>
          <span class="name">{artist}</span>
          <span class="count">{list.length} 首</span>
          <span class="samples">{list.slice(0, 3).map((song) => song.title).join(" · ")}</span>
        </a>
        <PinButton path={href(artist)} />
      </li>
    ))}
  </ul>
</section>

<nav class="letters" aria-label="依字母">
  {letters.map(([letter]) => <a href={`#${anchor(letter)}`}>{letter}</a>)}
</nav>

<div id="directory">
  {letters.map(([letter, groups]) => (
    <section class="letter" id={anchor(letter)}>
      <h2>{letter}</h2>
      <ul class="artists">
        {groups.map(([artist, list]) => (
          <li class="pinnable" data-path={href(artist)}>
            <a class="artist" href={href(artist)}>
              <span class="name">{artist}</span>
              <span class="count">{list.length} 首</span>
              <span class="samples">{list.slice(0, 3).map((song) => song.title).join(" · ")}</span>
            </a>
            <PinButton path={href(artist)} />
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<!-- Search results: rows built from /search.json on first use, then filtered in place. -->
<div id="results" hidden>
  <p id="summary" class="summary"></p>
  <ul class="hits"></ul>
</div>

<style>
  .search { display: none; margin: 2.5rem 0 0; }
  :global(.js) .search { display: block; }
  input {
    width: 100%;
    padding: 0.85rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
  }
  input::placeholder { color: var(--faint); }
  input:focus { outline: none; border-color: var(--accent); }

  .letters { display: flex; flex-wrap: wrap; gap: 0.25rem; margin: 1.25rem 0 0; }
  .letters a {
    min-width: 2rem;
    padding: 0.2rem 0.45rem;
    border-radius: 6px;
    color: var(--muted);
    text-align: center;
    text-decoration: none;
    letter-spacing: 0.05em;
  }
  .letters a:hover { color: var(--accent); background: var(--surface); }

  .letter { margin-top: 2.5rem; scroll-margin-top: 1rem; }
  h2 {
    margin: 0 0 0.75rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--rule);
    color: var(--accent);
    font-size: 1.5rem;
    font-weight: 700;
  }
  .artists {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Global inside the grid: pinned song cards are built in the browser without scope attributes. */
  .artists :global(.artist) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.15rem 0.75rem;
    height: 100%;
    padding: 0.9rem 3.1rem 0.9rem 1rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--surface);
    text-decoration: none;
  }
  .artists :global(.artist:hover) { border-color: var(--accent); }
  .artists :global(.artist:hover .name) { color: var(--accent); }
  .artists :global(.pinnable > .pin) { top: 0.85rem; right: 0.75rem; }
  /* A pinned card keeps a thin accent edge wherever it appears. */
  .artists :global(.pinnable:has(.pin[aria-pressed="true"]) .artist) { box-shadow: inset 0 2px 0 var(--accent); }
  .artists :global(.name) { font-size: 1.15rem; font-weight: 700; letter-spacing: 0.04em; }
  .artists :global(.count) { align-self: baseline; font-size: 0.8rem; color: var(--faint); }
  .artists :global(.kind) {
    padding: 0 0.4rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    font-size: 0.72rem;
    color: var(--muted);
  }
  .artists :global(.samples) {
    grid-column: 1 / -1;
    overflow: hidden;
    font-size: 0.82rem;
    color: var(--muted);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .summary { margin: 1.5rem 0 0.5rem; font-size: 0.9rem; color: var(--faint); }
  .hits { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--rule); }
  .hits :global(li) { border-bottom: 1px solid var(--rule); }
  .hits :global(a) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 3rem 0.7rem 0.25rem;
    text-decoration: none;
  }
  .hits :global(.pinnable > .pin) { top: 50%; right: 0.25rem; translate: 0 -50%; }
  .hits :global(a:hover .hit-title) { color: var(--accent); }
  .hits :global(.hit-title) { font-size: 1.1rem; }
  .hits :global(.hit-meta) { flex: none; font-size: 0.85rem; color: var(--muted); }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  import { type FoldTable, foldWith } from "../lib/fold";
  import { isArtist, pinButton, pins, render } from "../lib/pins";

  type Hit = { href: string; title: string; meta: string; search: string };

  const input = document.querySelector<HTMLInputElement>("#filter")!;
  const pinned = document.querySelector<HTMLElement>("#pinned")!;
  const pinnedList = pinned.querySelector<HTMLElement>(".artists")!;
  const directory = document.querySelector<HTMLElement>("#directory")!;
  const letters = document.querySelector<HTMLElement>(".letters")!;
  const results = document.querySelector<HTMLElement>("#results")!;
  const summary = document.querySelector<HTMLElement>("#summary")!;
  const list = results.querySelector<HTMLElement>(".hits")!;

  // One request serves both search and pinned songs.
  let data: Promise<{ table: FoldTable; hits: Hit[] }> | undefined;
  const fetchData = () =>
    (data ??= fetch("/search.json")
      .then((response) => {
        if (!response.ok) throw new Error(`search.json: ${response.status}`);
        return response.json() as Promise<{ table: FoldTable; hits: Hit[] }>;
      })
      .catch((error) => {
        data = undefined;
        throw error;
      }));

  const element = <K extends keyof HTMLElementTagNameMap>(parent: Node, tag: K, className?: string, text?: string) => {
    const child = parent.appendChild(document.createElement(tag));
    if (className) child.className = className;
    if (text !== undefined) child.textContent = text;
    return child;
  };

  // Traditional → simplified for every character in the titles and names, so either script matches.
  let index: Promise<{ table: FoldTable; rows: [HTMLElement, string][] }> | undefined;
  const load = () =>
    (index ??= fetchData()
      .then(({ table, hits }) => {
        const current = new Set(pins());
        const rows = hits.map(({ href, title, meta, search }): [HTMLElement, string] => {
          const item = document.createElement("li");
          item.className = "pinnable";
          const link = element(item, "a");
          link.href = href;
          element(link, "span", "hit-title", title);
          element(link, "span", "hit-meta", meta);
          item.append(pinButton(href, current.has(href)));
          item.hidden = true;
          return [item, search];
        });
        list.append(...rows.map(([item]) => item));
        return { table, rows };
      })
      .catch((error) => {
        index = undefined;
        throw error;
      }));

  // Directory cards by path, cloned into the pinned section; pinned songs get a card of their own.
  const cards = new Map(
    [...directory.querySelectorAll<HTMLElement>("li[data-path]")].map((item) => [item.dataset.path!, item]),
  );
  const songCard = ({ href, title, meta }: Hit) => {
    const item = document.createElement("li");
    item.className = "pinnable";
    item.dataset.path = href;
    const link = element(item, "a", "artist");
    link.href = href;
    element(link, "span", "name", title);
    element(link, "span", "count kind", "歌曲");
    element(link, "span", "samples", meta);
    item.append(pinButton(href, true));
    return item;
  };

  let generation = 0;
  const showPinned = async () => {
    const current = pins();
    const mine = ++generation;
    let songs = new Map<string, Hit>();
    if (current.some((path) => !isArtist(path))) {
      try {
        songs = new Map((await fetchData()).hits.map((hit) => [hit.href, hit]));
      } catch {}
      if (mine !== generation) return;
    }
    const items = current.flatMap((path) => {
      if (isArtist(path)) {
        const card = cards.get(path)?.cloneNode(true) as HTMLElement | undefined;
        return card ? [card] : [];
      }
      const hit = songs.get(path);
      return hit ? [songCard(hit)] : [];
    });
    pinnedList.replaceChildren(...items);
    render(pinnedList);
    pinned.dataset.empty = String(items.length === 0);
    pinned.hidden = items.length === 0 || Boolean(input.value.trim());
  };

  const update = async () => {
    const raw = input.value.trim();
    directory.hidden = letters.hidden = Boolean(raw);
    pinned.hidden = Boolean(raw) || pinned.dataset.empty === "true";
    results.hidden = !raw;
    if (!raw) return;
    let loaded;
    try {
      loaded = await load();
    } catch {
      summary.textContent = "搜尋暫時無法使用";
      return;
    }
    if (input.value.trim() !== raw) return;
    const query = foldWith(loaded.table, raw);
    let shown = 0;
    for (const [item, search] of loaded.rows) {
      item.hidden = !search.includes(query);
      if (!item.hidden) shown++;
    }
    summary.textContent = shown ? `${shown} 筆結果` : "找無符合的歌曲";
  };

  input.addEventListener("focus", () => void load().catch(() => {}), { once: true });
  input.addEventListener("input", () => void update());
  document.addEventListener("pins-change", () => void showPinned());
  void showPinned();
</script>
