---
import "@fontsource/noto-serif-tc/400.css";
import "@fontsource/noto-serif-tc/700.css";
// Noto Serif SC is linked only in 简 mode (pre-paint script below, lib/script.ts), so 繁 readers never load it.
import sc400 from "@fontsource/noto-serif-sc/400.css?url";
import sc700 from "@fontsource/noto-serif-sc/700.css?url";
import "../styles/global.css";
import { SOURCE_NAME, SOURCE_URL } from "../lib/source";
import { DEFAULT_PINNED_ARTISTS } from "../lib/artists";
import { artistPath } from "../lib/catalog";
import PinButton from "../components/PinButton.astro";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  type?: "website" | "article";
}
const { title, description, wide = false, type = "website" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const SITE_NAME = "台語歌詞";
const defaultPins = JSON.stringify(DEFAULT_PINNED_ARTISTS.map(artistPath));
---
<!doctype html>
<html lang="zh-Hant-TW" data-default-pins={defaultPins} data-sc-fonts={JSON.stringify([sc400, sc700])}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="preload" href="/fonts/Charis-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121214" media="(prefers-color-scheme: dark)" />
    <!-- Apply saved reading settings before first paint. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        try {
          const theme = localStorage.getItem("theme");
          if (theme === "light" || theme === "dark") root.dataset.theme = theme;
          const size = localStorage.getItem("size");
          if (size && /^[0-4]$/.test(size)) root.dataset.size = size;
          if (localStorage.getItem("romanization") === "off") root.dataset.romanization = "off";
          // Simplified pages stay hidden until lib/script.ts converts them (with a safety timeout).
          if (localStorage.getItem("script") === "hans") {
            root.dataset.script = "hans";
            root.classList.add("converting");
            for (const href of JSON.parse(root.dataset.scFonts)) {
              const link = document.head.appendChild(document.createElement("link"));
              link.rel = "stylesheet";
              link.href = href;
            }
            setTimeout(() => root.classList.remove("converting"), 1500);
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    <div class:list={["page", { wide }]}>
      <div class="corner">
        <div class="script-switch" role="group" aria-label="繁體／简体" data-no-convert>
          <button type="button" data-script="hant" aria-pressed="true">繁</button>
          <button type="button" data-script="hans" aria-pressed="false">简</button>
        </div>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="主題：自動" title="主題：自動">
          <svg class="icon-auto" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="8" />
            <path d="M12 4a8 8 0 0 1 0 16z" class="filled" />
          </svg>
          <svg class="icon-light" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
          </svg>
          <svg class="icon-dark" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
          </svg>
        </button>
      </div>
      <slot />
      <footer class="site-footer">
        <slot name="footer" />
        <p>
          歌詞與台羅拼音整理自 <a href={SOURCE_URL} rel="noopener">{SOURCE_NAME}</a>，依原稿呈現。
          字型：Charis SIL、Noto Serif TC。
        </p>
      </footer>
    </div>
    <PinButton />
    <script>
      import { start as startPins } from "../lib/pins";
      import { start as startScript } from "../lib/script";
      import { start as startTheme } from "../lib/theme";
      startScript();
      startTheme();
      startPins();
    </script>
  </body>
</html>
