---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import { artistSlug, byArtist, songs, type Song } from "../../lib/catalog";
import { classify } from "../../lib/transcription";
import { initial } from "../../lib/artists";
import PinButton from "../../components/PinButton.astro";

export const getStaticPaths = (() =>
  byArtist(songs()).map(([artist, list]) => ({ params: { slug: artistSlug(artist) }, props: { artist, list } }))
) satisfies GetStaticPaths;

interface Props {
  artist: string;
  list: Song[];
}
const { artist, list } = Astro.props;
// Long lists get letter dividers; songs arrive sorted by romanized title (artists.ts).
const divided = list.length > 10;
const path = `/artists/${artistSlug(artist)}/`;
const rows = list.map((song, index) => {
  const letter = initial(song.title);
  return {
    song,
    credits: classify(song.source).credits.join(" "),
    divider: divided && (index === 0 || initial(list[index - 1].title) !== letter) ? letter : undefined,
  };
});
---
<Base title={`${artist} · 台語歌詞`} description={`${artist} 的 ${list.length} 首台語歌詞與台羅拼音`}>
  <nav class="crumbs"><a href="/">← 全部歌手</a></nav>
  <header class="artist-head">
    <p class="eyebrow">歌手</p>
    <div class="title-row">
      <h1>{artist}</h1>
      <PinButton path={path} pill />
    </div>
    <p class="count">{list.length} 首歌</p>
  </header>
  <section id="pinned-songs" class="pinned-songs" aria-labelledby="pinned-songs-title" hidden>
    <h2 id="pinned-songs-title" class="divider">置頂</h2>
    <ol class="songs"></ol>
  </section>
  <ol class="songs" id="all-songs">
    {rows.map(({ song, credits, divider }) => (
      <li class:list={{ "has-divider": divider }}>
        {divider && <span class="divider" aria-hidden="true">{divider}</span>}
        <div class="pinnable" data-path={`/songs/${song.id}/`}>
          <a href={`/songs/${song.id}/`}>
            <span class="title" lang="nan-Hant">{song.title}</span>
            {credits && <span class="credits">{credits}</span>}
          </a>
          <PinButton path={`/songs/${song.id}/`} />
        </div>
      </li>
    ))}
  </ol>
</Base>

<style>
  .crumbs { font-size: 0.9rem; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }
  .artist-head { margin-top: 2.5rem; }
  .title-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; margin-top: 0.35rem; }
  h1 {
    margin: 0;
    font-size: clamp(2.1rem, 7vw, 3.1rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.2;
  }
  .count { margin: 0.5rem 0 0; color: var(--faint); font-size: 0.9rem; }
  .songs { margin: 2.5rem 0 0; padding: 0; list-style: none; border-top: 1px solid var(--rule); }
  .pinned-songs { margin-top: 2.5rem; }
  .pinned-songs h2 { margin: 0; padding-top: 0; }
  .pinned-songs .songs { margin-top: 0.4rem; }
  .pinned-songs .pinnable { box-shadow: inset 2px 0 0 var(--accent); }
  .pinned-songs .songs a { padding-left: 0.9rem; }
  .songs li { border-bottom: 1px solid var(--rule); }
  .divider {
    display: block;
    padding: 1.4rem 0.25rem 0.2rem;
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .songs a { display: block; padding: 0.85rem 3rem 0.85rem 0.25rem; text-decoration: none; }
  .songs .pinnable > :global(.pin) { top: 50%; right: 0.25rem; translate: 0 -50%; }
  .songs a:hover .title { color: var(--accent); }
  .title { display: block; font-size: 1.2rem; letter-spacing: 0.03em; }
  .credits { display: block; margin-top: 0.15rem; font-size: 0.8rem; color: var(--faint); }
</style>

<script>
  import { pins, render } from "../../lib/pins";

  // Pinned songs of this artist, in pin order, above the full list (which keeps them too).
  const section = document.querySelector<HTMLElement>("#pinned-songs")!;
  const list = section.querySelector<HTMLElement>(".songs")!;
  const rows = new Map(
    [...document.querySelectorAll<HTMLElement>("#all-songs .pinnable[data-path]")].map((row) => [row.dataset.path!, row]),
  );
  const show = () => {
    const items = pins().flatMap((path) => {
      const row = rows.get(path)?.closest("li");
      if (!row) return [];
      // The whole <li> keeps Astro's scoped styles; its letter divider stays behind.
      const item = row.cloneNode(true) as HTMLElement;
      item.querySelector(".divider")?.remove();
      item.classList.remove("has-divider");
      return [item];
    });
    list.replaceChildren(...items);
    render(list);
    section.hidden = items.length === 0;
  };
  document.addEventListener("pins-change", show);
  show();
</script>
