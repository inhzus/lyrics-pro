---
import Base from "../layouts/Base.astro";
import ArtistIndex from "../components/ArtistIndex.astro";
import { byInitial } from "../lib/artists";
import { byArtist, songs } from "../lib/catalog";
import { SOURCE_NAME, SOURCE_URL } from "../lib/source";

const list = songs();
const groups = byArtist(list);
---
<Base
  title="台語歌詞 · Taiwanese Lyrics"
  description="台語歌詞與台羅拼音 · Taiwanese lyrics with Tâi-lô romanization"
  wide
>
  <header class="hero">
    <p class="eyebrow">Tâi-gí kua-sû · Tâi-lô</p>
    <h1>台語歌詞</h1>
    <p class="lede">歌詞與台羅拼音 · Lyrics with Tâi-lô romanization</p>
    <p class="stats">{list.length} 首歌 · {groups.length} 位歌手</p>
    <p class="credit">
      歌詞與拼音出處 · Transcriptions from <a href={SOURCE_URL} rel="noopener">{SOURCE_NAME}</a>
    </p>
  </header>
  <ArtistIndex letters={byInitial(groups)} />
</Base>

<style>
  .hero { padding-top: 2rem; }
  h1 {
    margin: 0.4rem 0 0.2rem;
    font-size: clamp(2.6rem, 8vw, 4.2rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.15;
  }
  .lede { margin: 0; font-size: 1.15rem; color: var(--muted); }
  .stats { margin: 0.9rem 0 0; font-size: 0.9rem; color: var(--faint); }
  .credit { margin: 0.3rem 0 0; font-size: 0.9rem; color: var(--muted); }
  .credit a { color: var(--accent); }
</style>
