---
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import Lyrics from "../../../components/Lyrics.astro";
import ReadingControls from "../../../components/ReadingControls.astro";
import { artistPath, artistSlug, songPath, songs, type Song } from "../../../lib/catalog";
import { titleSlug } from "../../../lib/slug";
import { SOURCE_NAME, SOURCE_URL } from "../../../lib/source";
import { classify } from "../../../lib/transcription";
import PinButton from "../../../components/PinButton.astro";

export const getStaticPaths = (() => {
  const all = songs();
  return all.map((song) => ({
    params: { artist: artistSlug(song.artist), title: titleSlug(song.title) },
    props: { song, siblings: all.filter((other) => other.artist === song.artist && other.id !== song.id) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  song: Song;
  siblings: Song[];
}
const { song, siblings } = Astro.props;
const { credits, items } = classify(song.source);
const artistHref = artistPath(song.artist);
---
<Base
  title={`${song.title} · ${song.artist}`}
  description={`${song.title} – ${song.artist} 台語歌詞與台羅拼音`}
  type="article"
>
  <nav class="crumbs" aria-label="導覽">
    <a href="/" data-back>全部歌手</a><span class="sep" aria-hidden="true">/</span><a href={artistHref} data-back>{song.artist}</a>
  </nav>
  <header class="song-head">
    <p class="eyebrow"><a href={artistHref} data-back>{song.artist}</a></p>
    <div class="title-row">
      <h1 lang="nan-Hant">{song.title}</h1>
      <PinButton path={songPath(song)} pill />
    </div>
    {credits.length > 0 && (
      <div class="credits">{credits.map((line) => <p>{line}</p>)}</div>
    )}
  </header>
  <ReadingControls />
  <Lyrics items={items} />
  {siblings.length > 0 && (
    <section class="more">
      <h2><a href={artistHref} data-back>{song.artist}</a> 的其他歌曲</h2>
      <ul>
        {siblings.map((other) => <li><a href={songPath(other)}>{other.title}</a></li>)}
      </ul>
    </section>
  )}
  <p class="source">
    歌詞與台羅拼音出處：<a href={SOURCE_URL} rel="noopener">{SOURCE_NAME}</a>
  </p>
  <p slot="footer">原稿檔案：<code>{song.file}</code></p>
</Base>

<style>
  .crumbs { font-size: 0.9rem; color: var(--faint); }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }
  .crumbs .sep { margin: 0 0.5em; }
  .song-head { margin-top: 2.5rem; }
  .title-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; margin-top: 0.35rem; }
  h1 {
    margin: 0;
    font-size: clamp(2.1rem, 7vw, 3.1rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.2;
  }
  .credits { margin-top: 1rem; font-size: 0.85rem; color: var(--muted); }
  .credits p { margin: 0; }
  .eyebrow a { text-decoration: none; }
  .eyebrow a:hover { text-decoration: underline; }
  .source { margin: 3rem 0 0; font-size: 0.9rem; color: var(--muted); }
  .source a { color: var(--accent); }
  .more { margin-top: 2.5rem; }
  .more h2 a { color: var(--ink); }
  .more h2 { margin: 0 0 0.75rem; font-size: 0.95rem; font-weight: 400; color: var(--muted); }
  .more ul { display: flex; flex-wrap: wrap; gap: 0.35rem 1.4rem; margin: 0; padding: 0; list-style: none; }
  .more a { text-decoration: none; }
  .more a:hover { text-decoration: underline; }
</style>
